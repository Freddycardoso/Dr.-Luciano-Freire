---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Dr. Luciano Freire | Implantes Dentários e Odontologia em Passos - MG",
  description = "Especialista em implantes dentários, ortodontia e estética dental em Passos/MG. Atendimento com o Dr. Luciano Alves Freire (CRO-MG 25170). Agende sua avaliação.",
  image = "https://drlucianofreire.com.br/images/dr-luciano-freire.png",
  canonicalURL = "https://drlucianofreire.com.br",
} = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dentist",
      "@id": "https://drlucianofreire.com.br/#clinic",
      "name": "Consultório Odontológico Dr. Luciano Alves Freire",
      "image": "https://drlucianofreire.com.br/images/dr-luciano-freire.png",
      "telephone": "+553535215027",
      "priceRange": "$$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua dos Brandões, 231 - Sala 24, Centro",
        "addressLocality": "Passos",
        "addressRegion": "MG",
        "postalCode": "37900-104",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -20.7188,
        "longitude": -46.6111
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "reviewCount": "13"
      },
      "medicalSpecialty": [
        "https://schema.org/Dentistry"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://drlucianofreire.com.br/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O procedimento de implante dentário dói?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O procedimento de implante dentário é realizado com modernas técnicas de anestesia local para neutralizar a sensibilidade durante a cirurgia. Para o pós-operatório, são prescritas medicações adequadas para favorecer uma recuperação serena e confortável."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto tempo dura o tratamento de implante?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A fase de osseointegração costuma levar de 3 a 6 meses para que o pino de titânio se una de forma sólida ao osso. Após esse período, a coroa final de porcelana é fixada com estabilidade e precisão mastigatória."
          }
        },
        {
          "@type": "Question",
          "name": "Quem usa dentadura móvel pode colocar implante?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! A reabilitação com prótese protocolo fixada sobre implantes substitui a dentadura móvel proporcionando alta estabilidade e firmeza. O paciente recupera a capacidade mastigatória e a segurança ao sorrir, sem receio de deslocamentos da prótese."
          }
        },
        {
          "@type": "Question",
          "name": "Quem não tem dentes há muitos anos pode fazer implante?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. Mesmo pacientes com perda óssea acentuada podem realizar implantes, seja por meio de enxertos prévios ou técnicas avançadas de reabilitação. O planejamento radiográfico prévio avalia individualmente cada caso no consultório em Passos."
          }
        },
        {
          "@type": "Question",
          "name": "Qual o endereço do consultório em Passos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O consultório está localizado na Rua dos Brandões, 231, Sala 24 – Centro, Passos - MG (CEP 37900-104), em localização central de fácil acesso e estacionamento próximo."
          }
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#090E17" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Dr. Luciano Alves Freire - CRO-MG 25170" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Dr. Luciano Alves Freire | Odontologia Especializada" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Fonts Optimization -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- Static Structured Data (Schema.org JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <style is:global>
      :root {
        --color-champagne: #C5A880;
        --color-champagne-light: #E6D7BE;
        --color-navy-dark: #090E17;
        --color-navy-card: #0F172A;
        --ease-emil: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-apple: cubic-bezier(0.2, 0.8, 0.2, 1);
      }

      /* Mobile Native: Kill tap delay and highlight flash */
      html {
        -webkit-tap-highlight-color: transparent;
        text-size-adjust: 100%;
        -webkit-text-size-adjust: 100%;
      }

      button, a, input, select, textarea, [role="button"], [role="tab"] {
        touch-action: manipulation;
      }

      /* Native summary marker removal for zero-JS accordions */
      details summary::-webkit-details-marker {
        display: none;
      }
      details summary {
        list-style: none;
      }

      /* Smooth accordion disclosure animation */
      details[open] > div {
        animation: accordionSlideDown 240ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      @keyframes accordionSlideDown {
        from {
          opacity: 0;
          transform: translateY(-8px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* Tactile physical feedback for buttons & cards (Emil Kowalski) */
      .btn-tactile {
        user-select: none;
        -webkit-user-select: none;
        transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
      }
      .btn-tactile:active {
        transform: scale(0.96) !important;
      }

      .card-tactile {
        transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1), border-color 200ms ease, box-shadow 200ms ease;
      }
      @media (hover: hover) and (pointer: fine) {
        .card-tactile:hover {
          transform: translateY(-3px);
          border-color: rgba(197, 168, 128, 0.35);
          box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.65), 0 0 20px -5px rgba(197, 168, 128, 0.12);
        }
      }
      .card-tactile:active {
        transform: scale(0.985);
      }

      /* Scroll Reveal System (Hardware-Accelerated, Zero-JS bloat) */
      [data-reveal] {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 650ms cubic-bezier(0.16, 1, 0.3, 1), transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
        will-change: opacity, transform;
      }

      [data-reveal].is-revealed {
        opacity: 1;
        transform: translateY(0);
        will-change: auto;
      }

      /* Reveal Stagger Delays */
      [data-reveal-delay="75"] { transition-delay: 75ms; }
      [data-reveal-delay="100"] { transition-delay: 100ms; }
      [data-reveal-delay="150"] { transition-delay: 150ms; }
      [data-reveal-delay="200"] { transition-delay: 200ms; }
      [data-reveal-delay="250"] { transition-delay: 250ms; }
      [data-reveal-delay="300"] { transition-delay: 300ms; }
      [data-reveal-delay="350"] { transition-delay: 350ms; }
      [data-reveal-delay="400"] { transition-delay: 400ms; }
      [data-reveal-delay="500"] { transition-delay: 500ms; }

      /* Hero Staggered Load Animations */
      .hero-entrance-1 {
        animation: heroFadeUp 700ms cubic-bezier(0.16, 1, 0.3, 1) 50ms both;
      }
      .hero-entrance-2 {
        animation: heroFadeUp 750ms cubic-bezier(0.16, 1, 0.3, 1) 150ms both;
      }
      .hero-entrance-3 {
        animation: heroFadeUp 800ms cubic-bezier(0.16, 1, 0.3, 1) 250ms both;
      }
      .hero-entrance-4 {
        animation: heroFadeUp 850ms cubic-bezier(0.16, 1, 0.3, 1) 350ms both;
      }
      .hero-entrance-5 {
        animation: heroFadeUp 900ms cubic-bezier(0.16, 1, 0.3, 1) 450ms both;
      }
      .hero-doctor-entrance {
        animation: heroFadeInScale 950ms cubic-bezier(0.16, 1, 0.3, 1) 180ms both;
      }

      @keyframes heroFadeUp {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes heroFadeInScale {
        from {
          opacity: 0;
          transform: translateY(20px) scale(0.97);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      /* Subtle CTA Light Sheen Shimmer */
      .btn-shimmer {
        position: relative;
        overflow: hidden;
      }
      .btn-shimmer::after {
        content: '';
        position: absolute;
        top: -50%;
        left: -60%;
        width: 40%;
        height: 200%;
        background: linear-gradient(
          to right,
          rgba(255, 255, 255, 0) 0%,
          rgba(255, 255, 255, 0.28) 50%,
          rgba(255, 255, 255, 0) 100%
        );
        transform: rotate(25deg);
        pointer-events: none;
        animation: btnSheen 4.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
      }

      @keyframes btnSheen {
        0%, 65% {
          transform: translateX(-150%) rotate(25deg);
        }
        85%, 100% {
          transform: translateX(450%) rotate(25deg);
        }
      }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 9px;
      }
      ::-webkit-scrollbar-track {
        background: #090E17;
      }
      ::-webkit-scrollbar-thumb {
        background: #1e293b;
        border-radius: 5px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #334155;
      }

      /* Selection */
      ::selection {
        background-color: #c5a880;
        color: #090e17;
      }

      /* Performance: Section rendering containment for below-the-fold content */
      #anatomia,
      #tratamentos,
      #sobre,
      #avaliacoes,
      #faq,
      #localizacao {
        content-visibility: auto;
        contain-intrinsic-size: 1px 720px;
      }

      /* Accessibility: Respect prefers-reduced-motion */
      @media (prefers-reduced-motion: reduce) {
        *, ::before, ::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
        .btn-shimmer::after {
          display: none !important;
        }
      }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex flex-col selection:bg-gold-400 selection:text-slate-950 overflow-x-hidden">
    <slot />

    <!-- Lightweight High-Performance Scroll Observer & Header Controller -->
    <script is:inline>
      (function() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        
        // 1. Scroll Reveal Observer
        if (!prefersReducedMotion && 'IntersectionObserver' in window) {
          const revealElements = document.querySelectorAll('[data-reveal]');
          
          if (revealElements.length > 0) {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  observer.unobserve(entry.target);
                }
              });
            }, {
              threshold: 0.12,
              rootMargin: '0px 0px -40px 0px'
            });

            revealElements.forEach(el => observer.observe(el));
          }
        } else {
          // If reduced motion or no IntersectionObserver, reveal immediately
          document.querySelectorAll('[data-reveal]').forEach(el => el.classList.add('is-revealed'));
        }

        // 2. Header blur enhancement on scroll
        const header = document.querySelector('header');
        if (header) {
          let ticking = false;
          window.addEventListener('scroll', function() {
            if (!ticking) {
              window.requestAnimationFrame(function() {
                if (window.scrollY > 25) {
                  header.classList.add('shadow-lg', 'bg-slate-950/96', 'border-slate-800/90');
                } else {
                  header.classList.remove('shadow-lg', 'bg-slate-950/96', 'border-slate-800/90');
                }
                ticking = false;
              });
              ticking = true;
            }
          }, { passive: true });
        }
      })();
    </script>
  </body>
</html>
