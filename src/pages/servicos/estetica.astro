---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import heroImg from '../../assets/estetica-lentes-hero.jpg';
import detalheImg from '../../assets/estetica-faceta-detalhe.jpg';

const title = "Estética Dental em Passos | Dr. Luciano Freire";
const description = "Facetas em porcelana, lentes de contato dental e clareamento para um sorriso harmonioso. Desenho digital com naturalidade em Passos/MG.";
const whatsappUrl = "https://wa.me/5535988215162?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o%20de%20Est%C3%A9tica";
---

<Layout title={title} description={description}>
  <Header />
  
  <main id="main-content">
    <!-- HERO DO SERVIÇO -->
    <section class="relative bg-gradient-to-b from-white via-surface-subtle to-white overflow-hidden pt-28 pb-16 lg:pt-36 lg:pb-24 border-b border-brand-pale text-brand-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
          <div class="max-w-2xl">
            <!-- Breadcrumbs e Identificação do Tratamento -->
            <nav class="flex flex-wrap items-center gap-2 text-sm text-slate-500 mb-6" aria-label="Trilha de navegação">
              <a href="/" class="hover:text-brand-blue transition-colors flex items-center gap-1 font-medium">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                <span>Início</span>
              </a>
              <span class="text-slate-300">/</span>
              <a href="/#triagem" class="hover:text-brand-blue transition-colors font-medium">Tratamentos</a>
              <span class="text-slate-300">/</span>
              <span class="text-brand-blue font-bold" aria-current="page">Estética Dental</span>
            </nav>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-blue tracking-tight leading-[1.18] mb-6">
              Estética Dental com Naturalidade e Proporção Facial
            </h1>
            <p class="text-lg sm:text-xl text-slate-700 mb-8 leading-relaxed font-normal">
              Planejamento estético refinado que valoriza as linhas naturais do seu rosto. Facetas em porcelana, lentes de contato e clareamento dental conduzidos com precisão biológica e respeito à estrutura dental original.
            </p>
            <div class="flex flex-wrap items-center gap-4">
              <a 
                href={whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-tactile inline-flex items-center gap-2.5 bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold px-8 py-4 rounded-xl shadow-glow-whatsapp transition-colors text-base sm:text-lg min-h-[48px]"
              >
                <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
                <span>Agendar Avaliação Estética</span>
              </a>
            </div>
          </div>
          <div class="relative lg:ml-auto w-full max-w-lg">
            <div class="relative rounded-2xl overflow-hidden shadow-card border border-brand-pale bg-white p-2">
              <Image 
                src={heroImg} 
                alt="Modelo de estudo odontológico com facetas e lentes de contato em cerâmica de alta translucidez" 
                class="rounded-xl object-cover w-full h-[380px] lg:h-[460px]" 
                format="webp" 
                loading="eager"
                width={500}
                height={460}
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BARRA DE SERVIÇOS RÁPIDOS (MOBILE-FRIENDLY CHIPS) -->
    <nav class="bg-surface-soft border-b border-brand-pale py-3 px-4 sm:px-6 lg:px-8" aria-label="Navegação entre tratamentos">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 shrink-0">
          Explorar tratamentos:
        </span>
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
          <a href="/servicos/implantes" class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium bg-white border border-brand-pale text-slate-700 hover:text-brand-blue hover:border-brand-blue transition-colors">
            Implantes Dentários
          </a>
          <a href="/servicos/protocolo" class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium bg-white border border-brand-pale text-slate-700 hover:text-brand-blue hover:border-brand-blue transition-colors">
            Prótese Protocolo
          </a>
          <a href="/servicos/ortodontia" class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium bg-white border border-brand-pale text-slate-700 hover:text-brand-blue hover:border-brand-blue transition-colors">
            Ortodontia
          </a>
          <span class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold bg-brand-blue text-white shadow-xs">
            Estética Dental
          </span>
        </div>
      </div>
    </nav>

    <!-- TRATAMENTOS ESPECIALIZADOS -->
    <section class="py-20 bg-white border-b border-brand-pale">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-brand-dark mb-4">Tratamentos Especializados em Estética</h2>
          <p class="text-slate-600 text-lg leading-relaxed">Planejamento detalhado para resultados naturais, duradouros e harmoniosos.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Card 1 -->
          <div class="bg-surface-subtle rounded-2xl p-7 sm:p-8 border border-brand-pale flex flex-col justify-between card-tactile hover:border-brand-blue/40 transition-all duration-300 group">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-brand-blue/10 text-brand-blue flex items-center justify-center group-hover:scale-105 group-hover:bg-brand-blue group-hover:text-white transition-all duration-300 shadow-sm">
                  <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                  </svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-blue bg-white border border-brand-pale/80 px-3 py-1 rounded-full shadow-2xs">
                  Translucidez Natural
                </span>
              </div>
              <h3 class="text-xl font-bold text-brand-dark mb-2.5 group-hover:text-brand-blue transition-colors">
                Lentes e Facetas em Porcelana
              </h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Lâminas cerâmicas ultrafinas confeccionadas sob medida para corrigir contorno, formato, coloração e espaçamentos dentais com preparos minimamente invasivos.
              </p>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="bg-surface-subtle rounded-2xl p-7 sm:p-8 border border-brand-pale flex flex-col justify-between card-tactile hover:border-brand-blue/40 transition-all duration-300 group">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-brand-blue/10 text-brand-blue flex items-center justify-center group-hover:scale-105 group-hover:bg-brand-blue group-hover:text-white transition-all duration-300 shadow-sm">
                  <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
                  </svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-blue bg-white border border-brand-pale/80 px-3 py-1 rounded-full shadow-2xs">
                  Sem Sensibilidade
                </span>
              </div>
              <h3 class="text-xl font-bold text-brand-dark mb-2.5 group-hover:text-brand-blue transition-colors">
                Clareamento Dental Supervisionado
              </h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Protocolo clínico seguro para remoção de pigmentações profundas, iluminando a tonalidade do sorriso com proteção de esmalte e controle de sensibilidade.
              </p>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="bg-surface-subtle rounded-2xl p-7 sm:p-8 border border-brand-pale flex flex-col justify-between card-tactile hover:border-brand-blue/40 transition-all duration-300 group">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-brand-blue/10 text-brand-blue flex items-center justify-center group-hover:scale-105 group-hover:bg-brand-blue group-hover:text-white transition-all duration-300 shadow-sm">
                  <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-blue bg-white border border-brand-pale/80 px-3 py-1 rounded-full shadow-2xs">
                  Simetria Rosada
                </span>
              </div>
              <h3 class="text-xl font-bold text-brand-dark mb-2.5 group-hover:text-brand-blue transition-colors">
                Harmonia Gengival
              </h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Ajustes minuciosos no contorno e na simetria do zênite gengival para equilibrar com elegância a proporção visível entre dentes e tecido gengival.
              </p>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="bg-surface-subtle rounded-2xl p-7 sm:p-8 border border-brand-pale flex flex-col justify-between card-tactile hover:border-brand-blue/40 transition-all duration-300 group">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-brand-blue/10 text-brand-blue flex items-center justify-center group-hover:scale-105 group-hover:bg-brand-blue group-hover:text-white transition-all duration-300 shadow-sm">
                  <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-blue bg-white border border-brand-pale/80 px-3 py-1 rounded-full shadow-2xs">
                  Design do Sorriso
                </span>
              </div>
              <h3 class="text-xl font-bold text-brand-dark mb-2.5 group-hover:text-brand-blue transition-colors">
                Planejamento Digital e Proporção
              </h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Análise fotográfica e dinâmica do sorriso que assegura harmonia com a anatomia facial, idade e traços do paciente antes de qualquer desgaste.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- CASOS CLÍNICOS E DIFERENCIAIS -->
    <section class="py-20 bg-surface-subtle border-b border-brand-pale">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-brand-dark mb-4">Critérios Técnicos da Abordagem Estética</h2>
          <p class="text-slate-600 text-lg leading-relaxed">Equilíbrio entre ciência odontológica e harmonia visual para um sorriso autêntico.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center max-w-5xl mx-auto">
          <div class="lg:col-span-6">
            <div class="rounded-2xl overflow-hidden border border-brand-pale shadow-card bg-white p-3">
              <Image 
                src={detalheImg} 
                alt="Macro de lente de contato dental em porcelana pura ultrafina sobre placa de vidro junto à escala de cor VITA" 
                class="w-full h-auto object-cover rounded-xl max-h-[380px]" 
                format="webp" 
                loading="lazy"
                width={500}
                height={380}
              />
            </div>
          </div>
          <div class="lg:col-span-6 space-y-5">
            <div class="p-6 rounded-2xl bg-white border border-brand-pale shadow-sm">
              <h3 class="text-lg font-bold text-brand-dark mb-2">Translucidez e Mimetismo Óptico</h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Utilizamos cerâmicas de padrão internacional que reproduzem as gradações de cor, opalescência e textura do esmalte biológico, evitando resultados opacos ou artificiais.
              </p>
            </div>
            <div class="p-6 rounded-2xl bg-white border border-brand-pale shadow-sm">
              <h3 class="text-lg font-bold text-brand-dark mb-2">Preservação da Estrutura Biológica</h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Prioridade contínua ao desgaste minimamente invasivo. Quando indicado, as lentes de contato são aplicadas preservando ao máximo o dente natural.
              </p>
            </div>
            <div class="p-6 rounded-2xl bg-white border border-brand-pale shadow-sm">
              <h3 class="text-lg font-bold text-brand-dark mb-2">Atendimento Pessoal e Direto</h3>
              <p class="text-slate-600 text-base leading-relaxed">
                O Dr. Luciano Freire acompanha cada sessão individualmente, ouvindo os objetivos do paciente e refinando o ajuste oclusal com extremo rigor.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DEPOIMENTOS DE PACIENTES -->
    <section class="py-20 bg-white border-b border-brand-pale text-brand-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-brand-dark mb-4">Avaliações de Pacientes</h2>
          <p class="text-slate-600 text-lg leading-relaxed">Opiniões de pacientes atendidos no consultório em Passos/MG.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <div class="p-6 rounded-2xl bg-surface-subtle border border-brand-pale shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-1 text-brand-blue mb-3">
                {[...Array(5)].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <p class="text-slate-700 text-base leading-relaxed mb-4">
                "Espetacular! Profissionalismo impecável e atenção dedicada em cada etapa do atendimento odontológico. Meu sorriso ficou muito harmônico."
              </p>
            </div>
            <div class="border-t border-brand-pale/70 pt-3">
              <p class="font-bold text-brand-dark text-base">Ana Teresa Braz Rosa</p>
              <p class="text-base text-brand-blue font-semibold">Paciente Verificada • Google</p>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-surface-subtle border border-brand-pale shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-1 text-brand-blue mb-3">
                {[...Array(5)].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <p class="text-slate-700 text-base leading-relaxed mb-4">
                "Excelente Atendimento e Cuidado! Dr. Luciano tem um olhar estético diferenciado e passa uma confiança imensa do início ao fim."
              </p>
            </div>
            <div class="border-t border-brand-pale/70 pt-3">
              <p class="font-bold text-brand-dark text-base">Inovatório Marketing</p>
              <p class="text-base text-brand-blue font-semibold">Avaliação Verificada • Google</p>
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-surface-subtle border border-brand-pale shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-1 text-brand-blue mb-3">
                {[...Array(5)].map(() => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                ))}
              </div>
              <p class="text-slate-700 text-base leading-relaxed mb-4">
                "Pontualidade, higiene, profissionalismo e excelente atendimento. Dr. Luciano Freire é extremamente detalhista no acabamento."
              </p>
            </div>
            <div class="border-t border-brand-pale/70 pt-3">
              <p class="font-bold text-brand-dark text-base">Marco Arantes</p>
              <p class="text-base text-brand-blue font-semibold">Paciente Verificado • Google</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="py-24 bg-surface-subtle text-center relative overflow-hidden border-t border-brand-pale text-brand-dark">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <h2 class="text-3xl sm:text-4xl font-bold text-brand-dark mb-4">Agende uma Consulta de Avaliação Estética</h2>
        <p class="text-slate-600 mb-8 text-lg max-w-xl mx-auto">Converse diretamente com o Dr. Luciano Freire e entenda as opções para harmonizar o seu sorriso com segurança e conforto.</p>
        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-tactile inline-flex items-center gap-2.5 bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold px-8 py-4 rounded-xl shadow-glow-whatsapp transition-colors text-lg min-h-[48px]"
        >
          <span>Falar no WhatsApp com o Dr. Luciano</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <!-- BOTÃO FLUTUANTE WHATSAPP (56x56px, MÍNIMO 48px TOUCH TARGET) -->
  <aside class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50 flex items-center gap-3 [bottom:calc(1.25rem+env(safe-area-inset-bottom,0px))] [right:calc(1.25rem+env(safe-area-inset-right,0px))]">
    <!-- Callout Desktop -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-tactile hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/95 text-brand-dark border border-brand-pale text-base font-semibold shadow-card backdrop-blur-md hover:border-brand-blue transition-colors"
      aria-label="Agende sua avaliação de estética dental com o Dr. Luciano Freire"
    >
      <span class="w-2.5 h-2.5 rounded-full bg-accent-green"></span>
      <span>Avaliação de Estética</span>
    </a>

    <!-- Botão Redondo Touch Friendly -->
    <a
      href={whatsappUrl}
      target="_blank"
