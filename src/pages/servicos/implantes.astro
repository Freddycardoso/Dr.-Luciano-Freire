---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import heroImg from '../../assets/implante-macro-hero.jpg';
import implanteAnatomiaImg from '../../assets/implante-fundamentos-anatomia.jpg';

const title = "Implantes Dentários em Passos | Dr. Luciano Freire";
const description = "Recupere seu sorriso com implantes dentários. Procedimento seguro, alta precisão e materiais biocompatíveis em Passos/MG.";
const whatsappUrl = "https://wa.me/5535988215162?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o%20sobre%20Implantes";
---

<Layout title={title} description={description}>
  <Header />
  
  <main id="main-content">
    <!-- HERO DO SERVIÇO -->
    <section class="relative bg-gradient-to-b from-white via-surface-subtle to-white overflow-hidden pt-28 pb-16 lg:pt-36 lg:pb-24 border-b border-brand-pale text-brand-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
          <div class="max-w-2xl">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-blue tracking-tight leading-[1.18] mb-6">
              Implantes Dentários com Precisão e Planejamento Individualizado
            </h1>
            <p class="text-lg sm:text-xl text-slate-700 mb-8 leading-relaxed font-normal">
              Recupere a estabilidade da mastigação e a segurança de sorrir. Implantes de titânio biocompatíveis que substituem raízes perdidas com estética natural e preservação dos dentes vizinhos, conduzidos pessoalmente pelo Dr. Luciano Alves Freire.
            </p>
            <div class="flex flex-wrap items-center gap-4">
              <a 
                href={whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-tactile inline-flex items-center gap-2.5 bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold px-8 py-4 rounded-xl shadow-glow-whatsapp transition-colors text-base sm:text-lg min-h-[48px]"
              >
                <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
                <span>Agendar Avaliação no WhatsApp</span>
              </a>
            </div>
          </div>
          <div class="relative lg:ml-auto w-full max-w-lg">
            <div class="relative rounded-2xl overflow-hidden shadow-card border border-brand-pale bg-white p-2">
              <Image 
                src={heroImg} 
                alt="Implante dentário de titânio de precisão com coroa cerâmica sobre bandeja cirúrgica em aço inox com espelho clínico" 
                class="rounded-xl object-cover w-full h-[380px] lg:h-[460px]" 
                format="webp" 
                quality={95}
                loading="eager" 
                width={800}
                height={736}
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- BENTO GRID -->
    <section class="py-20 bg-white border-b border-brand-pale">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-brand-dark mb-4">Por que optar pela reabilitação com implantes?</h2>
          <p class="text-slate-600 text-lg leading-relaxed">Tratamento planejado com base em exames detalhados para máxima estabilidade e previsibilidade.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-surface-subtle rounded-2xl p-8 border border-brand-pale flex flex-col justify-between card-tactile">
            <div>
              <h3 class="text-xl font-bold text-brand-dark mb-3">Planejamento e Cirurgia Guiada</h3>
              <p class="text-slate-600 text-base leading-relaxed">Planejamento prévio minucioso para posicionamento milimétrico do implante na densidade óssea ideal, favorecendo uma recuperação serena.</p>
            </div>
          </div>
          <div class="bg-surface-subtle rounded-2xl p-8 border border-brand-pale flex flex-col justify-between card-tactile">
            <div>
              <h3 class="text-xl font-bold text-brand-dark mb-3">Titânio Biocompatível Puro</h3>
              <p class="text-slate-600 text-base leading-relaxed">Componentes certificados que estimulam a osseointegração biológica segura e duradoura junto à estrutura óssea da mandíbula e maxila.</p>
            </div>
          </div>
          <div class="bg-surface-subtle rounded-2xl p-8 border border-brand-pale flex flex-col justify-between card-tactile">
            <div>
              <h3 class="text-xl font-bold text-brand-dark mb-3">Recuperação da Eficiência Mastigatória</h3>
              <p class="text-slate-600 text-base leading-relaxed">Restauração da força e do apoio mastigatório para qualquer tipo de alimento, eliminando a insegurança de próteses móveis instáveis.</p>
            </div>
          </div>
          <div class="bg-surface-subtle rounded-2xl p-8 border border-brand-pale flex flex-col justify-between card-tactile">
            <div>
              <h3 class="text-xl font-bold text-brand-dark mb-3">Estética Semelhante ao Dente Natural</h3>
              <p class="text-slate-600 text-base leading-relaxed">Coroas protéticas em porcelana pura ou zircônia desenhadas para mimetizar com naturalidade a cor, textura e anatomia da arcada.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CASOS CLÍNICOS & DETALHE TÉCNICO -->
    <section class="py-20 bg-surface-subtle border-b border-brand-pale">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-brand-dark mb-4">Fundamentos da Reabilitação com Implante</h2>
          <p class="text-slate-600 text-lg leading-relaxed">Entenda a estrutura de sustentação e como ela devolve a harmonia biológica.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center max-w-5xl mx-auto">
          <div class="lg:col-span-6">
            <div class="rounded-2xl overflow-hidden border border-brand-pale shadow-card bg-white p-3 flex items-center justify-center">
              <Image 
                src={implanteAnatomiaImg} 
                alt="Diagrama anatômico realista de implante dentário de titânio osseointegrado ao osso alveolar com coroa cerâmica translúcida" 
                class="w-full h-auto object-contain rounded-xl max-h-[380px] bg-white"
                format="webp"
                loading="lazy"
                width={500}
                height={375}
              />
            </div>
          </div>
          <div class="lg:col-span-6 space-y-5">
            <div class="p-6 rounded-2xl bg-white border border-brand-pale shadow-sm">
              <h3 class="text-lg font-bold text-brand-dark mb-2">Fixação Definitiva na Estrutura Óssea</h3>
              <p class="text-slate-600 text-base leading-relaxed">
                O pino de titânio substitui a raiz biológica ausente com estabilidade comprovada, prevenindo a reabsorção óssea progressiva que ocorre após a perda do dente.
              </p>
            </div>
            <div class="p-6 rounded-2xl bg-white border border-brand-pale shadow-sm">
              <h3 class="text-lg font-bold text-brand-dark mb-2">Preservação dos Dentes Naturais Vizinhos</h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Diferente das próteses fixas convencionais que exigiam o desgaste de dentes adjacentes saudáveis, o implante é autônomo e protege 100% dos dentes vizinhos.
              </p>
            </div>
            <div class="p-6 rounded-2xl bg-white border border-brand-pale shadow-sm">
              <h3 class="text-lg font-bold text-brand-dark mb-2">Acompanhamento Conduzido pelo Dr. Luciano</h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Todas as consultas, medições e procedimentos são realizados pessoalmente pelo Dr. Luciano Alves Freire no Centro de Passos/MG, assegurando consistência clínica.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- DEPOIMENTO REAL EM VÍDEO -->
    <section class="py-20 lg:py-24 bg-gradient-to-b from-white via-surface-subtle/40 to-white border-b border-brand-pale text-brand-dark overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
          
          <!-- COLUNA ESQUERDA: VÍDEO DO PACIENTE -->
          <div class="lg:col-span-5 flex justify-center">
            <div class="relative w-full max-w-[340px] sm:max-w-[360px]">
              <!-- Brilho de fundo sutil com a paleta do consultório -->
              <div class="absolute -inset-2 bg-gradient-to-tr from-brand-blue/15 via-brand-pale/40 to-brand-blue/10 rounded-[2.5rem] blur-xl -z-10 transform -rotate-1"></div>
              
              <!-- Moldura Smartphone Premium -->
              <div class="relative rounded-[2.2rem] p-2.5 sm:p-3 bg-slate-900 border border-slate-700/60 shadow-2xl">
                <!-- Top Notch Speaker Bar -->
                <div class="absolute top-4 left-1/2 -translate-x-1/2 w-20 h-1.5 bg-slate-700/80 rounded-full z-20"></div>

                <div class="relative rounded-[1.7rem] overflow-hidden bg-black aspect-[9/16] shadow-inner group">
                  <video 
                    id="testimonial-video" 
                    class="w-full h-full object-cover rounded-[1.7rem]" 
                    playsinline 
                    preload="metadata"
                    controls
                    poster="/videos/depoimento-implante-poster.jpg"
                  >
                    <source src="/videos/depoimento-implante-dr-luciano.mp4" type="video/mp4" />
                    Seu navegador não suporta a reprodução de vídeo.
                  </video>

                  <!-- Overlay Interativo Inicial Limpo (Apenas botão play central com efeito de toque) -->
                  <div 
                    id="video-play-overlay" 
                    class="absolute inset-0 bg-slate-950/25 hover:bg-slate-950/15 flex flex-col items-center justify-center p-5 cursor-pointer transition-all duration-300 z-10"
                    role="button"
                    tabindex="0"
                    aria-label="Assistir relato do paciente Anderson"
                  >
                    <div class="flex flex-col items-center gap-3">
                      <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-white/95 text-brand-dark flex items-center justify-center shadow-2xl transition-transform duration-300 group-hover:scale-110 ring-4 ring-white/30">
                        <svg class="w-7 h-7 sm:w-8 sm:h-8 fill-brand-blue translate-x-0.5" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </div>
                      <span class="text-white text-xs font-semibold tracking-wide bg-slate-950/70 backdrop-blur-sm px-3.5 py-1.5 rounded-full border border-white/15 shadow-sm">
                        Assistir relato em vídeo (1 min)
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- COLUNA DIREITA: TEXTO PERSUASIVO QUE ATICE A CURIOSIDADE -->
          <div class="lg:col-span-7 space-y-6">
            
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-dark tracking-tight leading-[1.2]">
              O que fez o Anderson vencer o medo e finalmente realizar o sonho do implante?
            </h2>

            <p class="text-slate-700 text-base sm:text-lg leading-relaxed font-normal">
              Por muito tempo, lembranças de tratamentos desconfortáveis e o receio de sentir dor fizeram o Anderson adiar o momento de cuidar do seu sorriso. Ele acreditava que colocar um implante seria uma experiência dolorosa e difícil de encarar.
            </p>

            <p class="text-slate-700 text-base sm:text-lg leading-relaxed font-normal">
              No vídeo ao lado de apenas 1 minuto, ele sentou ao lado do Dr. Luciano Freire e revelou com sinceridade o que sentiu na pele durante o procedimento — e como tudo aconteceu de forma completamente oposta ao que imaginava.
            </p>

            <!-- Gatilhos de Curiosidade / Pontos de Valor -->
            <div class="space-y-3.5 pt-1">
              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-brand-blue/10 text-brand-blue flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
                  ✓
                </div>
                <p class="text-slate-700 text-base leading-snug">
                  <strong class="text-brand-dark font-bold">Por que não houve dor:</strong> Como a técnica anestésica e o planejamento milimétrico garantem uma cirurgia serena.
                </p>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-brand-blue/10 text-brand-blue flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
                  ✓
                </div>
                <p class="text-slate-700 text-base leading-snug">
                  <strong class="text-brand-dark font-bold">O impacto no dia a dia:</strong> A sensação libertadora de voltar a mastigar com estabilidade sem receio do dente soltar.
                </p>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-6 h-6 rounded-full bg-brand-blue/10 text-brand-blue flex items-center justify-center shrink-0 mt-0.5 font-bold text-xs">
                  ✓
                </div>
                <p class="text-slate-700 text-base leading-snug">
                  <strong class="text-brand-dark font-bold">Cuidado no seu ritmo:</strong> A diferença de ser atendido por um profissional que escuta você antes de qualquer intervenção.
                </p>
              </div>
            </div>

            <!-- Transição Persuasiva Direcionando para a Seção de Agendamento Abaixo (Sem botão duplicado) -->
            <div class="pt-4 border-t border-brand-pale">
              <div class="p-4 rounded-xl bg-surface-soft border border-brand-pale/80 flex items-center gap-3 text-slate-700">
                <svg class="w-5 h-5 text-brand-blue shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <p class="text-sm sm:text-base font-medium leading-snug">
                  Dê o play no vídeo ao lado para ver a experiência completa. Logo abaixo, veja como agendar a sua avaliação individual com o Dr. Luciano.
                </p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <script>
      const video = document.getElementById('testimonial-video') as HTMLVideoElement | null;
      const overlay = document.getElementById('video-play-overlay');

      if (video && overlay) {
        const handleStartPlay = () => {
          overlay.classList.add('opacity-0', 'pointer-events-none');
          video.play().catch(() => {});
        };

        overlay.addEventListener('click', handleStartPlay);
        overlay.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            handleStartPlay();
          }
        });

        video.addEventListener('play', () => {
          overlay.classList.add('opacity-0', 'pointer-events-none');
        });

        video.addEventListener('ended', () => {
          overlay.classList.remove('opacity-0', 'pointer-events-none');
        });
      }
    </script>

    <!-- CTA FINAL -->
    <section class="py-24 bg-surface-subtle text-center relative overflow-hidden border-t border-brand-pale text-brand-dark">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <h2 class="text-3xl sm:text-4xl font-bold text-brand-dark mb-4">Pronto para Recuperar a Firmeza do seu Sorriso?</h2>
        <p class="text-slate-600 mb-8 text-lg max-w-xl mx-auto">Dê o primeiro passo para restaurar a eficiência mastigatória e o bem-estar com um plano de implante seguro.</p>
        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-tactile inline-flex items-center gap-2.5 bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold px-8 py-4 rounded-xl shadow-glow-whatsapp transition-colors text-lg min-h-[48px]"
        >
          <span>Agendar Avaliação de Implante no WhatsApp</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
