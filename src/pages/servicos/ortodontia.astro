---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ServiceHeroVisual from '../../components/ServiceHeroVisual.astro';
import { Image } from 'astro:assets';
import detalheImg from '../../assets/ortodontia-modelo-detalhe.jpg';

const title = "Alinhadores Transparentes em Passos | Dr. Luciano Freire";
const description = "Alinhadores transparentes e ortodontia moderna para alinhar seus dentes com conforto, discrição e planejamento digital em Passos/MG.";
const whatsappUrl = "https://wa.me/5535988215162?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20saber%20mais%20sobre%20Alinhadores%20Transparentes";
---

<Layout title={title} description={description}>
  <Header />
  
  <main id="main-content">
    <!-- HERO DO SERVIÇO -->
    <section class="relative bg-gradient-to-b from-white via-surface-subtle to-white overflow-hidden pt-28 pb-16 lg:pt-36 lg:pb-24 border-b border-brand-pale text-brand-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
          <div class="max-w-2xl">
            <!-- Breadcrumbs e Identificação do Tratamento -->
            <nav class="flex flex-wrap items-center gap-2 text-sm text-slate-500 mb-6" aria-label="Trilha de navegação">
              <a href="/" class="hover:text-brand-blue transition-colors flex items-center gap-1 font-medium">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                <span>Início</span>
              </a>
              <span class="text-slate-300">/</span>
              <a href="/#triagem" class="hover:text-brand-blue transition-colors font-medium">Tratamentos</a>
              <span class="text-slate-300">/</span>
              <span class="text-brand-blue font-bold" aria-current="page">Ortodontia</span>
            </nav>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-blue tracking-tight leading-[1.18] mb-6">
              Alinhamento Dental com Discrição, Conforto e Tecnologia
            </h1>
            <p class="text-lg sm:text-xl text-slate-700 mb-8 leading-relaxed font-normal">
              Corrija o posicionamento dos seus dentes sem o desconforto dos bráquetes metálicos tradicionais. Alinhadores transparentes sob medida que garantem higiene descomplicada, conforto biológico e discrição total para sua rotina.
            </p>
            <div class="flex flex-wrap items-center gap-4">
              <a 
                href={whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-tactile inline-flex items-center gap-2.5 bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold px-8 py-4 rounded-xl shadow-glow-whatsapp transition-colors text-base sm:text-lg min-h-[48px]"
              >
                <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
                <span>Agendar Avaliação Ortodôntica</span>
              </a>
            </div>
          </div>
          <ServiceHeroVisual specialty="Ortodontia" badges={['Ortodontia', 'Alinhadores Transparentes', 'Planejamento Digital']} />
        </div>
      </div>
    </section>

    <!-- BARRA DE SERVIÇOS RÁPIDOS (MOBILE-FRIENDLY CHIPS) -->
    <nav class="bg-surface-soft border-b border-brand-pale py-3 px-4 sm:px-6 lg:px-8" aria-label="Navegação entre tratamentos">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-2.5">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 shrink-0">
          Explorar tratamentos:
        </span>
        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1">
          <a href="/servicos/implantes" class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium bg-white border border-brand-pale text-slate-700 hover:text-brand-blue hover:border-brand-blue transition-colors">
            Implantes Dentários
          </a>
          <a href="/servicos/protocolo" class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium bg-white border border-brand-pale text-slate-700 hover:text-brand-blue hover:border-brand-blue transition-colors">
            Prótese Protocolo
          </a>
          <span class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold bg-brand-blue text-white shadow-xs">
            Ortodontia
          </span>
          <a href="/servicos/estetica" class="shrink-0 px-3.5 py-1.5 rounded-full text-xs font-medium bg-white border border-brand-pale text-slate-700 hover:text-brand-blue hover:border-brand-blue transition-colors">
            Estética Dental
          </a>
        </div>
      </div>
    </nav>

    <!-- BENTO GRID -->
    <section class="py-20 bg-white border-b border-brand-pale">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-brand-dark mb-4">Vantagens dos Alinhadores Transparentes</h2>
          <p class="text-slate-600 text-lg leading-relaxed">Tratamento ortodôntico contemporâneo com etapas previsíveis e livres de incômodos.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Card 1 -->
          <div class="bg-surface-subtle rounded-2xl p-7 sm:p-8 border border-brand-pale flex flex-col justify-between card-tactile hover:border-brand-blue/40 transition-all duration-300 group">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-brand-blue/10 text-brand-blue flex items-center justify-center group-hover:scale-105 group-hover:bg-brand-blue group-hover:text-white transition-all duration-300 shadow-sm">
                  <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-blue bg-white border border-brand-pale/80 px-3 py-1 rounded-full shadow-2xs">
                  Imperceptível
                </span>
              </div>
              <h3 class="text-xl font-bold text-brand-dark mb-2.5 group-hover:text-brand-blue transition-colors">
                Discrição e Estética Social
              </h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Confeccionados em polímero transparente de alta fidelidade visual, tornando os alinhadores praticamente invisíveis em reuniões, fotos e interações do dia a dia.
              </p>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="bg-surface-subtle rounded-2xl p-7 sm:p-8 border border-brand-pale flex flex-col justify-between card-tactile hover:border-brand-blue/40 transition-all duration-300 group">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-brand-blue/10 text-brand-blue flex items-center justify-center group-hover:scale-105 group-hover:bg-brand-blue group-hover:text-white transition-all duration-300 shadow-sm">
                  <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-blue bg-white border border-brand-pale/80 px-3 py-1 rounded-full shadow-2xs">
                  Praticidade
                </span>
              </div>
              <h3 class="text-xl font-bold text-brand-dark mb-2.5 group-hover:text-brand-blue transition-colors">
                Higiene Bucal Simplificada
              </h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Removíveis para alimentação e escovação rotineira, garantindo o uso correto do fio dental sem retenção de resíduos característica dos bráquetes metálicos.
              </p>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="bg-surface-subtle rounded-2xl p-7 sm:p-8 border border-brand-pale flex flex-col justify-between card-tactile hover:border-brand-blue/40 transition-all duration-300 group">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-brand-blue/10 text-brand-blue flex items-center justify-center group-hover:scale-105 group-hover:bg-brand-blue group-hover:text-white transition-all duration-300 shadow-sm">
                  <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-blue bg-white border border-brand-pale/80 px-3 py-1 rounded-full shadow-2xs">
                  Conforto Biológico
                </span>
              </div>
              <h3 class="text-xl font-bold text-brand-dark mb-2.5 group-hover:text-brand-blue transition-colors">
                Conforto para Bochechas e Lábios
              </h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Superfície milimetricamente desenhada e bordas polidas que não arranham os tecidos moles nem provocam as lesões frequentes dos aparelhos convencionais.
              </p>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="bg-surface-subtle rounded-2xl p-7 sm:p-8 border border-brand-pale flex flex-col justify-between card-tactile hover:border-brand-blue/40 transition-all duration-300 group">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-brand-blue/10 text-brand-blue flex items-center justify-center group-hover:scale-105 group-hover:bg-brand-blue group-hover:text-white transition-all duration-300 shadow-sm">
                  <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-blue bg-white border border-brand-pale/80 px-3 py-1 rounded-full shadow-2xs">
                  Digital 3D
                </span>
              </div>
              <h3 class="text-xl font-bold text-brand-dark mb-2.5 group-hover:text-brand-blue transition-colors">
                Previsibilidade no Planejamento
              </h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Cada movimento dental é sequenciado digitalmente por escaneamento intraoral, possibilitando visualizar a evolução do alinhamento antes de iniciar o ciclo de placas.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- CASOS CLÍNICOS & DETALHES -->
    <section class="py-20 bg-surface-subtle border-b border-brand-pale">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-brand-dark mb-4">Como Funciona o Fluxo Ortodôntico</h2>
          <p class="text-slate-600 text-lg leading-relaxed">Etapas coordenadas para um alinhamento harmonioso e confortável.</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center max-w-5xl mx-auto">
          <div class="lg:col-span-6">
            <div class="rounded-2xl overflow-hidden border border-brand-pale shadow-card bg-white p-3">
              <Image 
                src={detalheImg} 
                alt="Alinhador ortodôntico transparente adaptado com precisão sobre modelo de arcada dental de estudo" 
                class="w-full h-auto object-cover rounded-xl max-h-[380px]" 
                format="webp" 
                loading="lazy"
                width={500}
                height={380}
              />
            </div>
          </div>
          <div class="lg:col-span-6 space-y-5">
            <div class="p-6 rounded-2xl bg-white border border-brand-pale shadow-sm">
              <h3 class="text-lg font-bold text-brand-dark mb-2">Alinhadores Anatômicos Sob Medida</h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Placas confortáveis produzidas a partir do escaneamento da sua arcada, assegurando encaixe preciso que não prejudica a dicção nem a rotina diária.
              </p>
            </div>
            <div class="p-6 rounded-2xl bg-white border border-brand-pale shadow-sm">
              <h3 class="text-lg font-bold text-brand-dark mb-2">Diagnóstico e Escaneamento</h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Captura detalhada da oclusão através de parcerias com centros radiológicos modernos em Passos/MG, dispensando desconfortos desnecessários.
              </p>
            </div>
            <div class="p-6 rounded-2xl bg-white border border-brand-pale shadow-sm">
              <h3 class="text-lg font-bold text-brand-dark mb-2">Liberdade em Todas as Refeições</h3>
              <p class="text-slate-600 text-base leading-relaxed">
                Você remove os alinhadores para se alimentar com total liberdade, sem restrições a alimentos crocantes ou receio de quebrar peças.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="py-24 bg-surface-subtle text-center relative overflow-hidden border-t border-brand-pale text-brand-dark">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <h2 class="text-3xl sm:text-4xl font-bold text-brand-dark mb-4">Alinhe seu Sorriso com Discrição e Conforto</h2>
        <p class="text-slate-600 mb-8 text-lg max-w-xl mx-auto">Agende uma consulta de avaliação ortodôntica com o Dr. Luciano Freire e conheça as possibilidades para o seu sorriso.</p>
        <a 
          href={whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-tactile inline-flex items-center gap-2.5 bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold px-8 py-4 rounded-xl shadow-glow-whatsapp transition-colors text-lg min-h-[48px]"
        >
          <span>Agendar Avaliação Ortodôntica no WhatsApp</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />

  <!-- BOTÃO FLUTUANTE WHATSAPP (56x56px, MÍNIMO 48px TOUCH TARGET) -->
  <aside class="fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-50 flex items-center gap-3 [bottom:calc(1.25rem+env(safe-area-inset-bottom,0px))] [right:calc(1.25rem+env(safe-area-inset-right,0px))]">
    <!-- Callout Desktop -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-tactile hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/95 text-brand-dark border border-brand-pale text-base font-semibold shadow-card backdrop-blur-md hover:border-brand-blue transition-colors"
      aria-label="Agende sua avaliação de alinhadores transparentes com o Dr. Luciano Freire"
    >
      <span class="w-2.5 h-2.5 rounded-full bg-accent-green"></span>
      <span>Avaliação Ortodôntica</span>
    </a>

    <!-- Botão Redondo Touch Friendly -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-tactile animate-beacon relative flex items-center justify-center w-14 h-14 rounded-full bg-whatsapp text-slate-950 shadow-glow-whatsapp hover:bg-whatsapp-hover"
      aria-label="Conversar pelo WhatsApp com o Dr. Luciano Alves Freire sobre Ortodontia no número (35) 98821-5162"
    >
      <span class="sr-only">Conversar pelo WhatsApp com o Dr. Luciano Alves Freire sobre Ortodontia</span>
      <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
      </svg>
    </a>
  </aside>
</Layout>
