---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import heroImg from '../../assets/servico_protocolo.jpg';

const title = "Prótese Protocolo em Passos | Dr. Luciano Freire";
const description = "Dentes fixos e segurança ao sorrir. Substitua a dentadura móvel pela prótese protocolo sobre implantes com o Dr. Luciano Freire em Passos/MG.";
const whatsappUrl = "https://wa.me/5535988215162?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o%20sobre%20Protocolo";
---

<Layout title={title} description={description}>
  <Header />
  
  <!-- HERO DO SERVIÇO -->
  <section class="relative bg-[#0B192C] overflow-hidden pt-24 pb-16 lg:pt-32 lg:pb-24 border-b border-[#1A3358]/80 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        <div class="max-w-2xl">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold text-white tracking-tight mb-6">
            Liberdade com a Prótese Protocolo Fixa
          </h1>
          <p class="text-lg text-slate-200 mb-8 leading-relaxed font-normal">
            Diga adeus às próteses móveis (dentaduras). A prótese protocolo fixa sobre implantes devolve a segurança para falar, sorrir e mastigar qualquer alimento com total conforto e firmeza.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-tactile inline-flex items-center gap-2.5 bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold px-7 py-4 rounded-xl shadow-glow-whatsapp transition-colors">
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
              <span>Avaliar Meu Caso no WhatsApp</span>
            </a>
          </div>
        </div>
        <div class="relative lg:ml-auto w-full max-w-lg">
          <div class="absolute inset-0 bg-gold-400/20 rounded-[2.5rem] transform rotate-3 scale-105 origin-bottom-right blur-sm"></div>
          <Image src={heroImg} alt="Prótese Protocolo Fixa - Dr. Luciano Freire" class="relative rounded-[2rem] shadow-2xl object-cover w-full h-[400px] lg:h-[500px] border border-[#1E3E66]" format="webp" />
        </div>
      </div>
    </div>
  </section>

  <!-- BENTO GRID -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-serif font-bold text-slate-900 mb-4">A verdadeira qualidade de vida</h2>
        <p class="text-slate-600">Entenda os diferenciais e benefícios da reabilitação total fixa sobre implantes.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[250px]">
        <div class="md:col-span-2 bg-slate-50 rounded-3xl p-8 border border-slate-200 flex flex-col justify-end card-tactile relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-gold-100 rounded-full blur-3xl opacity-50 -translate-y-1/2 translate-x-1/3"></div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 relative z-10">Firmeza e Estabilidade Absolutas</h3>
          <p class="text-slate-600 relative z-10">Fixada sobre apenas 4 a 6 implantes de titânio, a prótese não se desloca, não cai e não machuca a mucosa gengival ao mastigar ou conversar.</p>
        </div>
        <div class="bg-[#0B192C] text-white rounded-3xl p-8 border border-[#1A3358] flex flex-col justify-end card-tactile">
          <h3 class="text-xl font-bold text-white mb-2">Paladar 100% Livre</h3>
          <p class="text-slate-300">Sem acrílico recobrindo o céu da boca, permitindo sentir novamente a temperatura e o sabor genuíno de todas as refeições.</p>
        </div>
        <div class="bg-gold-50 rounded-3xl p-8 border border-gold-200 flex flex-col justify-end card-tactile">
          <h3 class="text-xl font-bold text-slate-900 mb-2">Carga Imediata quando indicada</h3>
          <p class="text-slate-600">Em casos clínicos elegíveis, os dentes fixos são instalados em poucos dias após o procedimento cirúrgico.</p>
        </div>
        <div class="md:col-span-2 bg-slate-50 rounded-3xl p-8 border border-slate-200 flex flex-col justify-end card-tactile">
          <h3 class="text-xl font-bold text-slate-900 mb-2">Rejuvenescimento e Harmonia Facial</h3>
          <p class="text-slate-600">Devolve a dimensão vertical e o suporte dos lábios e bochechas, amenizando rugas peri-orais e restaurando o perfil jovem da face.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CASOS CLÍNICOS & IMAGENS -->
  <section class="py-20 bg-slate-50 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-serif font-bold text-slate-900 mb-4">Casos Clínicos & Imagens do Tratamento</h2>
        <p class="text-slate-600">Veja como a prótese protocolo fixa transforma a estética e a função dos pacientes.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center max-w-5xl mx-auto">
        <div class="lg:col-span-6">
          <div class="rounded-3xl overflow-hidden border border-slate-200 shadow-xl bg-white p-3">
            <Image 
              src={heroImg} 
              alt="Prótese Protocolo Fixa - Caso clínico Dr. Luciano Freire" 
              class="w-full h-auto object-cover rounded-2xl max-h-[380px]"
              format="webp"
            />
          </div>
        </div>
        <div class="lg:col-span-6 space-y-6">
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
            <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Substituição Completa da Arcada</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Ideal para quem usa dentadura há anos ou possui dentes remanescentes comprometidos. Uma única estrutura fixa devolve todos os dentes com alinhamento e proporções perfeitas.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
            <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Cirurgia Guiada com Máximo Conforto</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              O posicionamento dos pinos de titânio é simulado digitalmente em 3D antes da cirurgia, reduzindo o tempo do procedimento e acelerando a recuperação pós-operatória.
            </p>
          </div>
          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm">
            <h3 class="font-serif text-lg font-bold text-slate-900 mb-2">Atendimento Pessoal com o Dr. Luciano</h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Com mais de 20 anos de experiência clínica, o Dr. Luciano Freire planeja e executa a reabilitação em Passos/MG, assegurando precisão oclusal e estética personalizada.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DEPOIMENTOS DE PACIENTES -->
  <section class="py-20 bg-[#0B192C] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-serif font-bold text-white mb-4">O que dizem nossos pacientes</h2>
        <p class="text-slate-300">A experiência de quem conquistou dentes fixos novamente.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="p-6 rounded-2xl bg-[#0F223D] border border-[#1E3E66] shadow-md flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-1 text-gold-400 mb-3">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-slate-200 text-sm leading-relaxed mb-4">
              "A prótese protocolo mudou completamente minha rotina. Voltar a comer maçã e churrasco sem nenhuma preocupação não tem preço. Trabalho impecável do Dr. Luciano."
            </p>
          </div>
          <div class="border-t border-[#1E3E66] pt-3">
            <p class="font-bold text-white text-sm">Gerson Eduardo Rosa</p>
            <p class="text-xs text-gold-400">Paciente Verificado • Google</p>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-[#0F223D] border border-[#1E3E66] shadow-md flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-1 text-gold-400 mb-3">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-slate-200 text-sm leading-relaxed mb-4">
              "Se tivessem mais estrelas daria, excelente profissional, pontual, muito humano, trabalha muito bem, super recomendo para quem precisa de dentes fixos."
            </p>
          </div>
          <div class="border-t border-[#1E3E66] pt-3">
            <p class="font-bold text-white text-sm">Fabiane Oliveira</p>
            <p class="text-xs text-gold-400">Paciente Verificada • Google</p>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-[#0F223D] border border-[#1E3E66] shadow-md flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-1 text-gold-400 mb-3">
              {[...Array(5)].map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-slate-200 text-sm leading-relaxed mb-4">
              "Doutor Luciano me devolveu a segurança de sorrir e mastigar. Procedimento muito tranquilo, sem dor e com acompanhamento impecável do início ao fim."
            </p>
          </div>
          <div class="border-t border-[#1E3E66] pt-3">
            <p class="font-bold text-white text-sm">Maria Helena Silveira</p>
            <p class="text-xs text-gold-400">Paciente Verificada • Google</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="py-24 bg-[#0B192C] text-center relative overflow-hidden border-t border-[#1A3358]/80 text-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-white mb-6">Pronto para ter dentes fixos novamente?</h2>
      <p class="text-slate-300 mb-10 text-lg">Diga adeus à insegurança da prótese móvel. Agende uma avaliação detalhada e descubra a solução ideal para o seu caso.</p>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-tactile inline-flex items-center gap-2 bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold px-8 py-4 rounded-xl shadow-glow-whatsapp transition-colors">
        Falar com o Dr. Luciano
      </a>
    </div>
  </section>

  <Footer />
</Layout>
