---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';
import heroImg from '../../assets/servico_protocolo.jpg';

const title = "Prótese Protocolo em Passos | Dr. Luciano Freire";
const description = "Dentes fixos e segurança ao sorrir. Substitua a dentadura móvel pela prótese protocolo sobre implantes.";
---

<Layout title={title} description={description}>
  <Header />
  
  <section class="relative bg-babyblue-50 overflow-hidden pt-24 pb-16 lg:pt-32 lg:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-8 items-center">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white border border-slate-200 text-slate-600 text-xs font-bold uppercase tracking-wider mb-6">
            <span class="w-2 h-2 rounded-full bg-gold-500"></span>
            Reabilitação Total
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold text-slate-900 tracking-tight mb-6">
            Liberdade com a Prótese Protocolo
          </h1>
          <p class="text-lg text-slate-600 mb-8 leading-relaxed">
            Diga adeus às próteses móveis (dentaduras). A prótese protocolo fixa sobre implantes devolve a segurança para falar, sorrir e mastigar com conforto.
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="https://wa.me/5535988215162?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o%20sobre%20Protocolo" class="btn-tactile bg-gold-600 text-white font-bold px-6 py-3.5 rounded-xl shadow-lg hover:bg-gold-500 transition-colors">
              Agendar Avaliação
            </a>
          </div>
        </div>
        <div class="relative lg:ml-auto w-full max-w-lg">
          <div class="absolute inset-0 bg-gold-200/30 rounded-[2.5rem] transform rotate-3 scale-105 origin-bottom-right"></div>
          <Image src={heroImg} alt="Prótese Protocolo" class="relative rounded-[2rem] shadow-2xl object-cover w-full h-[400px] lg:h-[500px]" format="webp" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl font-serif font-bold text-slate-900 mb-4">A verdadeira qualidade de vida</h2>
        <p class="text-slate-600">Entenda os diferenciais da reabilitação total fixa.</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[250px]">
        <div class="md:col-span-2 bg-slate-50 rounded-3xl p-8 border border-slate-100 flex flex-col justify-end card-tactile relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-gold-100 rounded-full blur-3xl opacity-50 -translate-y-1/2 translate-x-1/3"></div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 relative z-10">Firmeza e Estabilidade</h3>
          <p class="text-slate-600 relative z-10">Fixada sobre implantes (geralmente de 4 a 6 pinos), não machuca a gengiva nem corre o risco de cair.</p>
        </div>
        <div class="bg-babyblue-50 rounded-3xl p-8 border border-babyblue-100 flex flex-col justify-end card-tactile">
          <h3 class="text-xl font-bold text-slate-900 mb-2">Paladar Livre</h3>
          <p class="text-slate-600">Sem acrílico recobrindo o céu da boca, permitindo sentir o sabor real dos alimentos.</p>
        </div>
        <div class="bg-gold-50 rounded-3xl p-8 border border-gold-100 flex flex-col justify-end card-tactile">
          <h3 class="text-xl font-bold text-slate-900 mb-2">Carga Imediata</h3>
          <p class="text-slate-600">Em casos selecionados, os dentes fixos provisórios são colocados em poucos dias.</p>
        </div>
        <div class="md:col-span-2 bg-slate-50 rounded-3xl p-8 border border-slate-100 flex flex-col justify-end card-tactile">
          <h3 class="text-xl font-bold text-slate-900 mb-2">Harmonia Facial</h3>
          <p class="text-slate-600">Devolve o suporte labial, rejuvenescendo o perfil da face e restaurando a proporção correta.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-slate-900 text-center relative overflow-hidden">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h2 class="text-3xl sm:text-4xl font-serif font-bold text-white mb-6">Pronto para ter dentes fixos novamente?</h2>
      <a href="https://wa.me/5535988215162?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o%20sobre%20Protocolo" class="btn-tactile inline-flex items-center gap-2 bg-gold-500 text-slate-900 font-bold px-8 py-4 rounded-xl shadow-lg hover:bg-gold-400 transition-colors">
        Falar com a Equipe
      </a>
    </div>
  </section>

  <Footer />
</Layout>
