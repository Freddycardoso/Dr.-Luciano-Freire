              [class*="Carousel__Dot"][class*="active"],
              [class*="CarouselDots"] [class*="active"] {
                background-color: #D4AF37 !important;
              }
            `;

            function applyDarkElfsight(root) {
              if (!root) return;

              // Injeta estilo Dark Slate & Gold se não existir
              if (!root.querySelector('#elfsight-dark-custom-style')) {
                const style = document.createElement('style');
                style.id = 'elfsight-dark-custom-style';
                style.textContent = darkElfsightCSS;
                root.appendChild(style);
              }

              // Traduz botão para "Avaliar no Google"
              const buttons = root.querySelectorAll('button, a, [class*="Button"]');
              buttons.forEach(btn => {
                if (btn.textContent && btn.textContent.toLowerCase().includes('review us')) {
                  btn.textContent = 'Avaliar no Google';
                }
              });

              // Traduz "Read more" / "Read less"
              const readMores = root.querySelectorAll('[class*="Shortener"], [class*="read-more"], button');
              readMores.forEach(el => {
                if (el.textContent === 'Read more') el.textContent = 'Ler mais';
                if (el.textContent === 'Read less') el.textContent = 'Ler menos';
              });

              // Traduz datas relativas
              const dates = root.querySelectorAll('[class*="Date"], [class*="date"]');
              dates.forEach(el => {
                let t = el.textContent || '';
                if (t.includes('ago') || t.includes('yesterday')) {
                  t = t.replace(/(\d+)\s+days?\s+ago/gi, '$1 dias atrás')
                       .replace(/(\d+)\s+weeks?\s+ago/gi, '$1 semanas atrás')
                       .replace(/(\d+)\s+months?\s+ago/gi, '$1 meses atrás')
                       .replace(/(\d+)\s+years?\s+ago/gi, '$1 anos atrás')
                       .replace(/a\s+year\s+ago/gi, '1 ano atrás')
                       .replace(/a\s+month\s+ago/gi, '1 mês atrás')
                       .replace(/a\s+week\s+ago/gi, '1 semana atrás')
                       .replace(/yesterday/gi, 'ontem');
                  el.textContent = t;
                }
              });
            }

            // 1. Intercepta attachShadow no protótipo para capturar o ShadowRoot na hora da criação
            if (!window.__elfsightShadowHooked) {
              window.__elfsightShadowHooked = true;
              const origAttachShadow = Element.prototype.attachShadow;
              Element.prototype.attachShadow = function(init) {
                const shadow = origAttachShadow.call(this, init);
                try {
                  setTimeout(() => applyDarkElfsight(shadow), 10);
                  const obs = new MutationObserver(() => applyDarkElfsight(shadow));
                  obs.observe(shadow, { childList: true, subtree: true });
                } catch(e) {}
                return shadow;
              };
            }

            // 2. Fallback de varredura recursiva
            function scanExistingShadows() {
              const container = document.querySelector('.elfsight-app-f6287144-a910-465a-a00a-2da2a0e4a02a');
              if (!container) return;

              function walk(node) {
                if (!node) return;
                if (node.shadowRoot) {
                  applyDarkElfsight(node.shadowRoot);
                  if (!node.shadowRoot.__observed) {
                    node.shadowRoot.__observed = true;
                    const o = new MutationObserver(() => applyDarkElfsight(node.shadowRoot));
                    o.observe(node.shadowRoot, { childList: true, subtree: true });
                  }
                  Array.from(node.shadowRoot.querySelectorAll('*')).forEach(walk);
                }
                Array.from(node.children || []).forEach(walk);
              }
              walk(container);
            }

            // Execuções periódicas de verificação
            [200, 600, 1200, 2000, 3500].forEach(delay => {
              setTimeout(scanExistingShadows, delay);
            });
          })();
        </script>

