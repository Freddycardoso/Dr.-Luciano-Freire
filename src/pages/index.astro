---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image, getImage } from 'astro:assets';
import drLucianoImg from '../assets/dr-luciano-freire.png';
import drLucianoConsultorioHeroImg from '../assets/dr-luciano-consultorio-hero.png';
import clinicBgHeroImg from '../assets/clinic-bg-hero.jpg';
import consultorioHeroImg from '../assets/consultorio-hero-cropped.png';
import consultorioEsperaImg from '../assets/consultorio-sala-espera.png';
import consultorioPlacaImg from '../assets/consultorio-placa-entrada.png';
import denteNaturalImg from '../assets/dente-natural-comparativo.png';
import implanteTitanioImg from '../assets/implante-titanio-comparativo.png';
import ServicesCarousel from '../components/ServicesCarousel';
import { AnatomyComparisonSlider } from '../components/AnatomyComparisonSlider';
import GoogleReviews from '../components/GoogleReviews.astro';

import implanteImg from '../assets/servico_implante.jpg';
import protocoloImg from '../assets/servico_protocolo.jpg';
import esteticaImg from '../assets/servico_estetica.jpg';
import ortodontiaImg from '../assets/servico_ortodontia.jpg';

const optimizedNaturalImg = await getImage({ src: denteNaturalImg, format: 'webp', width: 500 });
const optimizedImplantImg = await getImage({ src: implanteTitanioImg, format: 'webp', width: 500 });

const optImplante = await getImage({ src: implanteImg, format: 'webp', width: 600 });
const optProtocolo = await getImage({ src: protocoloImg, format: 'webp', width: 600 });
const optEstetica = await getImage({ src: esteticaImg, format: 'webp', width: 600 });
const optOrtodontia = await getImage({ src: ortodontiaImg, format: 'webp', width: 600 });

const carouselServices = [
  { 
    id: 'implantes', 
    title: 'Implantes Dentários', 
    description: 'Substituição da raiz dental perdida por implante de titânio biocompatível. Firmeza mastigatória e estética natural sem desgastar dentes vizinhos.', 
    href: '/servicos/implantes', 
    imageSrc: optImplante.src 
  },
  { 
    id: 'protocolo', 
    title: 'Prótese Protocolo Fixo', 
    description: 'Reabilitação completa com dentes fixos suportados por implantes. Devolva a força da mastigação e dispense o uso de dentaduras móveis.', 
    href: '/servicos/protocolo', 
    imageSrc: optProtocolo.src 
  },
  { 
    id: 'estetica', 
    title: 'Estética Dental e Clareamento', 
    description: 'Facetas e lentes de contato em cerâmica de alta durabilidade, além de clareamento supervisionado para harmonia do sorriso.', 
    href: '/servicos/estetica', 
    imageSrc: optEstetica.src 
  },
  { 
    id: 'ortodontia', 
    title: 'Ortodontia e Alinhadores', 
    description: 'Alinhadores transparentes e aparelhos modernos para correção do posicionamento dental com discrição, conforto e previsibilidade.', 
    href: '/servicos/ortodontia', 
    imageSrc: optOrtodontia.src 
  },
];

const whatsappBaseUrl = "https://wa.me/5535988215162";
const heroWhatsappUrl = `${whatsappBaseUrl}?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o%20no%20consult%C3%B3rio.`;
---

<Layout>
  <!-- SPLASH SCREEN CLARO E SUAVE -->
  <div id="splash-screen" class="fixed inset-0 z-[100] bg-white flex flex-col items-center justify-center transition-colors duration-700">
    <div id="splash-logo-container" class="relative w-48 sm:w-64 transition-transform duration-[1000ms] ease-[cubic-bezier(0.2,0.8,0.2,1)] origin-center">
      <!-- Dimmed logo -->
      <img src="/images/logo-simplificada.svg" alt="Logotipo do Consultório Dr. Luciano Freire" class="w-full h-auto object-contain opacity-20" width="256" height="100" loading="eager" />
      <!-- Illuminated logo with clip-path sweep -->
      <div id="splash-logo-lit" class="absolute inset-0 overflow-hidden" style="clip-path: inset(0 0 100% 0);">
        <img src="/images/logo-simplificada.svg" alt="Logotipo do Consultório Dr. Luciano Freire" class="w-full h-auto object-contain" width="256" height="100" loading="eager" />
      </div>
    </div>
  </div>

  <!-- HEADER -->
  <Header />

  <main id="main-content">
    <!-- 1. HERO COM FUNDO CLARO E FOTO REAL DO CONSULTÓRIO -->
    <section id="hero" class="relative min-h-[640px] lg:min-h-[740px] flex items-center overflow-hidden border-b border-brand-pale bg-surface-subtle">
      <!-- Background: Foto do Consultório com Degradê Direcional Suave -->
      <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
        <Image
          src={consultorioHeroImg}
          alt="Sala de atendimento do consultório odontológico do Dr. Luciano Freire em Passos MG"
          class="w-full h-full object-cover object-right lg:object-[68%_center] opacity-40 brightness-105"
          format="webp"
          quality={70}
          widths={[640, 1024, 1280]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
        <!-- Degradê direcional branco e luminoso para assegurar contraste e legibilidade perfeita do texto -->
        <div class="absolute inset-0 bg-gradient-to-r from-white via-white/95 lg:via-white/85 to-white/40"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-white via-white/80 to-transparent lg:hidden"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-8 pb-16 lg:pt-14 lg:pb-24">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-7 flex flex-col justify-center text-center lg:text-left items-center lg:items-start pt-6 sm:pt-8">
            
            <!-- Título Principal Fluido (Source Sans 3, Sem Serifa) -->
            <h1 class="hero-entrance-2 text-3xl sm:text-4xl lg:text-[44px] font-bold text-brand-blue tracking-tight leading-[1.18] mb-4 max-w-2xl">
              Volte a sorrir com segurança, firmeza e bem-estar.
            </h1>

            <!-- Parágrafo Factual com Tipografia Fluida (18px a 20px) -->
            <p class="hero-entrance-3 text-lg sm:text-xl text-slate-700 leading-relaxed mb-8 max-w-xl font-normal">
              Com mais de 21 anos de prática clínica em Passos/MG, o <strong class="text-brand-dark font-bold">Dr. Luciano Alves Freire</strong> conduz pessoalmente cada atendimento, unindo precisão diagnóstica, técnicas consagradas e foco no seu conforto.
            </p>

            <!-- Ação Principal Touch-Friendly (Mínimo 48px de altura, texto 18px) -->
            <div class="hero-entrance-4 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-8 lg:mb-4">
              <a 
                href={heroWhatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-tactile inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold text-lg min-h-[48px] shadow-glow-whatsapp w-full sm:w-auto transition-colors"
              >
                <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
                </svg>
                <span>Agendar Avaliação no WhatsApp</span>
              </a>
            </div>

            <!-- Foto Real do Dr. Luciano no Consultório (Mobile) -->
            <div class="block lg:hidden w-full max-w-[310px] sm:max-w-[340px] mx-auto hero-entrance-5 mt-6 mb-2">
              <div class="relative bg-white p-2.5 rounded-3xl border border-brand-pale shadow-card">
                <div class="relative rounded-2xl overflow-hidden aspect-[3/4] bg-slate-100">
                  <Image 
                    src={drLucianoConsultorioHeroImg} 
                    alt="Dr. Luciano Alves Freire no consultório odontológico em Passos MG" 
                    class="w-full h-full object-cover object-top select-none" 
                    widths={[320, 480]} 
                    sizes="(max-width: 640px) 310px, 340px" 
                    format="webp" 
                    quality={85} 
                    loading="eager" 
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- Foto Real do Dr. Luciano no Consultório (Desktop) -->
          <div class="hidden lg:flex lg:col-span-5 relative justify-end items-center min-h-[500px]">
            <div class="hero-doctor-entrance relative w-full max-w-[440px] ml-auto">
              <!-- Glow suave no fundo -->
              <div class="absolute -inset-4 rounded-[2.5rem] bg-gradient-to-tr from-brand-light/30 via-brand-pale/50 to-transparent blur-2xl pointer-events-none -z-10"></div>
              
              <!-- Moldura Premium Sem Eyebrows -->
              <div class="relative bg-white p-3 rounded-[2rem] border border-brand-pale shadow-[0_20px_50px_rgba(30,42,68,0.12)]">
                <div class="relative rounded-[1.5rem] overflow-hidden aspect-[3/4] bg-slate-100">
                  <Image 
                    src={drLucianoConsultorioHeroImg} 
                    alt="Dr. Luciano Alves Freire, Cirurgião-Dentista fotografado no consultório em Passos MG" 
                    class="w-full h-full object-cover object-top select-none" 
                    widths={[440, 640, 768]} 
                    sizes="440px" 
                    format="webp" 
                    quality={85} 
                    loading="eager" 
                    fetchpriority="high" 
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. SERVIÇOS EM DESTAQUE / CARROSSEL -->
    <section id="triagem" class="relative bg-white py-20 lg:py-28 text-brand-dark border-b border-brand-pale">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16" data-reveal>
          <h2 class="text-3xl sm:text-4xl lg:text-[34px] font-bold text-brand-dark tracking-tight mb-4">
            Tratamentos Odontológicos Especializados
          </h2>
          <p class="text-slate-600 text-lg leading-relaxed max-w-2xl mx-auto">
            Conheça as áreas de atuação do consultório, planejadas com rigor técnico para restabelecer a estética, o alinhamento e a plena função mastigatória.
          </p>
        </div>
        <div class="mb-10 w-full" data-reveal data-reveal-delay="100">
          <ServicesCarousel client:visible services={carouselServices} />
        </div>
      </div>
    </section>

    <!-- 3. COMPARADOR ANATÔMICO & BENEFÍCIOS -->
    <section id="comparador" class="relative bg-surface-subtle py-20 lg:py-28 border-b border-brand-pale text-brand-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16" data-reveal>
          <h2 class="text-3xl sm:text-4xl lg:text-[34px] font-bold text-brand-dark tracking-tight mb-4">
            Firmeza e Estabilidade Semelhantes à Raiz Natural
          </h2>
          <p class="text-slate-600 text-lg leading-relaxed max-w-2xl mx-auto">
            Arraste o comparador para visualizar como o implante substitui o dente com alta precisão estética e mastigatória, preservando integralmente os dentes saudáveis adjacentes.
          </p>
        </div>

        <div class="flex flex-col items-center justify-center mb-20" data-reveal data-reveal-delay="100">
          <div class="p-3 sm:p-4 rounded-3xl bg-white border border-brand-pale shadow-card w-full max-w-[460px]">
            <AnatomyComparisonSlider client:visible naturalSrc={optimizedNaturalImg.src} implantSrc={optimizedImplantImg.src} />
          </div>
          <p class="text-base text-slate-600 text-center mt-3 font-medium">
            Arraste para comparar: dente biológico à esquerda e implante fixo de titânio à direita.
          </p>
          <a href={heroWhatsappUrl} target="_blank" rel="noopener noreferrer" class="mt-4 text-brand-blue hover:text-brand-deep text-base font-bold transition-colors flex items-center gap-1.5 group">
            <span>Tirar dúvidas sobre implantes no WhatsApp</span> 
            <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">→</span>
          </a>
        </div>

        <!-- CARDS DE BENEFÍCIOS (AMPLIADOS PARA MÁXIMA LEGIBILIDADE) -->
        <div class="max-w-6xl mx-auto" data-reveal data-reveal-delay="200">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
            <div class="p-7 sm:p-8 lg:p-9 rounded-2xl sm:rounded-3xl bg-white border-l-[6px] border-l-brand-blue border border-brand-pale shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
              <div>
                <h3 class="text-xl sm:text-2xl font-bold text-brand-dark mb-3">Sorria com tranquilidade</h3>
                <p class="text-slate-700 text-base sm:text-lg leading-relaxed font-normal">
                  Cerâmicas odontológicas de alta pureza que conservam brilho, textura e tonalidade harmoniosa ao longo do tempo.
                </p>
              </div>
            </div>
            <div class="p-7 sm:p-8 lg:p-9 rounded-2xl sm:rounded-3xl bg-white border-l-[6px] border-l-brand-blue border border-brand-pale shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
              <div>
                <h3 class="text-xl sm:text-2xl font-bold text-brand-dark mb-3">Mastigue com segurança</h3>
                <p class="text-slate-700 text-base sm:text-lg leading-relaxed font-normal">
                  O pino de titânio biocompatível se integra à estrutura óssea, restaurando o suporte essencial para mastigar com confiança.
                </p>
              </div>
            </div>
            <div class="p-7 sm:p-8 lg:p-9 rounded-2xl sm:rounded-3xl bg-white border-l-[6px] border-l-brand-blue border border-brand-pale shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
              <div>
                <h3 class="text-xl sm:text-2xl font-bold text-brand-dark mb-3">Palato desimpedido</h3>
                <p class="text-slate-700 text-base sm:text-lg leading-relaxed font-normal">
                  Diferente de próteses móveis, a reabilitação fixa sobre implantes deixa o céu da boca livre para sentir o sabor e a temperatura dos alimentos.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. ETAPAS DO TRATAMENTO (CONFORMIDADE CFO: SEM PROMESSAS IRREAIS) -->
    <section id="jornada" class="relative bg-white py-20 lg:py-28 border-b border-brand-pale text-slate-700">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14" data-reveal>
          <h2 class="text-3xl sm:text-4xl lg:text-[34px] font-bold text-brand-dark tracking-tight mb-4">
            Etapas do Tratamento: Planejamento Seguro e Foco no Conforto
          </h2>
          <p class="text-slate-600 text-lg leading-relaxed max-w-xl mx-auto">
            Conheça as etapas organizadas para restabelecer seu sorriso com previsibilidade, precisão técnica e acompanhamento atencioso.
          </p>
        </div>
        
        <div class="relative max-w-2xl mx-auto pb-8" id="jornada-timeline">
          <!-- Static Base Line -->
          <div class="absolute left-6 top-2 bottom-2 w-1 bg-brand-pale rounded-full"></div>
          
          <!-- Animated Progress Line -->
          <div id="jornada-progress-line" class="absolute left-6 top-2 bottom-2 w-1 bg-brand-blue rounded-full shadow-[0_0_8px_rgba(66,107,178,0.4)] z-10"></div>

          <div class="space-y-16">
            <div class="relative group pl-16 jornada-step" data-reveal data-reveal-delay="75">
              <div class="absolute left-[19px] top-1.5 w-3.5 h-3.5 rounded-full bg-brand-blue border-2 border-white shadow-md z-20 step-dot"></div>
              <div>
                <h3 class="text-xl sm:text-2xl font-bold text-brand-dark mb-2">Passo 01: Diagnóstico e Planejamento Individualizado</h3>
                <p class="text-slate-600 text-base leading-relaxed">Avaliação detalhada da estrutura dental e integração com centros radiológicos para exames de imagem e tomografia computadorizada.</p>
              </div>
            </div>
            <div class="relative group pl-16 jornada-step" data-reveal data-reveal-delay="150">
              <div class="absolute left-[19px] top-1.5 w-3.5 h-3.5 rounded-full bg-brand-blue border-2 border-white shadow-md z-20 step-dot"></div>
              <div>
                <h3 class="text-xl sm:text-2xl font-bold text-brand-dark mb-2">Passo 02: Procedimento Guiado com Máximo Cuidado</h3>
                <p class="text-slate-600 text-base leading-relaxed">Intervenção cirúrgica planejada com precisão, utilizando anestesia moderna e protocolo cuidadoso para máxima tranquilidade do paciente.</p>
              </div>
            </div>
            <div class="relative group pl-16 jornada-step" data-reveal data-reveal-delay="225">
              <div class="absolute left-[19px] top-1.5 w-3.5 h-3.5 rounded-full bg-brand-blue border-2 border-white shadow-md z-20 step-dot"></div>
              <div>
                <h3 class="text-xl sm:text-2xl font-bold text-brand-dark mb-2">Passo 03: Reabilitação e Instalação Definitiva</h3>
                <p class="text-slate-600 text-base leading-relaxed">Instalação e refinamento oclusal da prótese definitiva, devolvendo a plena estabilidade da mastigação e a harmonia estética.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. AUTORIDADE & ATENDIMENTO PESSOAL -->
    <section id="autoridade" class="relative bg-surface-subtle py-20 lg:py-28 border-b border-brand-pale text-brand-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
          
          <div class="lg:col-span-5 flex justify-center" data-reveal data-reveal-delay="100">
            <div class="relative w-full max-w-[280px] sm:max-w-xs lg:max-w-md">
              <div class="relative rounded-2xl overflow-hidden bg-white border border-brand-pale shadow-card card-tactile">
                <Image 
                  src={drLucianoImg} 
                  alt="Dr. Luciano Alves Freire, Cirurgião-Dentista formado com mais de 21 anos de prática clínica em Passos MG, CRO MG 25.170" 
                  class="w-full h-auto object-cover" 
                  widths={[360, 500]} 
                  sizes="(max-width: 768px) 280px, 450px" 
                  format="webp" 
                  loading="lazy" 
                />
                <div class="p-4 bg-surface-soft border-t border-brand-pale text-center">
                  <p class="font-bold text-brand-dark text-lg">Dr. Luciano Alves Freire</p>
                  <p class="text-base text-brand-blue font-bold">Cirurgião-Dentista • CRO MG 25.170</p>
                </div>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7 flex flex-col justify-center" data-reveal data-reveal-delay="200">
            <div>
              <h2 class="text-3xl sm:text-4xl lg:text-[34px] font-bold text-brand-dark tracking-tight mb-4">
                Diagnóstico Preciso e Atendimento Conduzido Pessoalmente
              </h2>
              <p class="text-slate-700 text-lg leading-relaxed mb-8 max-w-2xl font-normal">
                Com mais de 21 anos de prática clínica no Centro de Passos, o Dr. Luciano Alves Freire conduz pessoalmente cada etapa do seu atendimento — da avaliação inicial ao acompanhamento pós-procedimento.
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
              <div class="p-5 rounded-2xl bg-white border border-brand-pale shadow-sm card-tactile">
                <div class="text-brand-blue font-bold text-2xl mb-1">+21 Anos</div>
                <div class="text-base font-bold text-brand-dark mb-1">Prática Clínica</div>
                <p class="text-base text-slate-600 leading-relaxed">Atuação contínua e dedicada na cidade de Passos/MG.</p>
              </div>
              <div class="p-5 rounded-2xl bg-white border border-brand-pale shadow-sm card-tactile">
                <div class="text-brand-blue font-bold text-2xl mb-1">100% Pessoal</div>
                <div class="text-base font-bold text-brand-dark mb-1">Cuidado Direto</div>
                <p class="text-base text-slate-600 leading-relaxed">Consultas e intervenções executadas exclusivamente pelo titular.</p>
              </div>
              <div class="p-5 rounded-2xl bg-white border border-brand-pale shadow-sm card-tactile">
                <div class="text-brand-blue font-bold text-2xl mb-1">Passos - MG</div>
                <div class="text-base font-bold text-brand-dark mb-1">Consultório Próprio</div>
                <p class="text-base text-slate-600 leading-relaxed">Atendimento individualizado com agendamento prévio.</p>
              </div>
            </div>

            <div class="text-center sm:text-left">
              <a 
                href={heroWhatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-tactile inline-flex justify-center items-center gap-2.5 px-8 py-4 rounded-xl bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold text-base min-h-[48px] shadow-glow-whatsapp w-full sm:w-auto"
              >
                <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
                </svg>
                <span>Falar Diretamente com o Dr. Luciano</span>
              </a>
            </div>
