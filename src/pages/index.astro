---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import drLucianoImg from '../assets/dr-luciano-freire.png';
import drLucianoHeroImg from '../assets/dr-luciano-freire-hero.png';
import logoClinica from '../assets/logo-clinica-nobg.png';
import logoIcon from '../assets/logo-icon.png';
import denteNaturalImg from '../assets/dente-natural-comparativo.png';
import implanteTitanioImg from '../assets/implante-titanio-comparativo.png';
import { BeamsBackground } from '../components/ui/beams-background';
import { PatientSituationNavigator } from '../components/PatientSituationNavigator';
import { AnatomyComparisonSlider } from '../components/AnatomyComparisonSlider';
import { SurgicalPathwayTimeline } from '../components/SurgicalPathwayTimeline';

const whatsappBaseUrl = "https://wa.me/5535988215162";
const heroWhatsappUrl = `${whatsappBaseUrl}?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o%20de%20implante%20dent%C3%A1rio`;
const phoneFixed = "(35) 3521-5027";
const phoneFixedClean = "553535215027";
const currentYear = new Date().getFullYear();
---

<Layout>
  <!-- =========================================================================
       DOBRA 1: HEADER FIXO & IDENTIDADE OFICIAL
       - Logo oficial sem fundo em destaque
       - Navegação limpa e objetiva
       ========================================================================= -->
  <header class="sticky top-0 z-40 bg-slate-950/92 backdrop-blur-lg border-b border-slate-800/60 transition-colors duration-150">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 lg:h-[4.5rem]">
        <!-- Logo Oficial sem Fundo -->
        <a href="#" class="group flex items-center focus:outline-none focus:ring-2 focus:ring-gold-400 rounded-lg btn-tactile py-1" aria-label="Dr. Luciano Alves Freire - Início">
          <Image
            src={logoClinica}
            alt="Logo Dr. Luciano Alves Freire - Consultório Odontológico"
            class="h-9 sm:h-11 w-auto object-contain drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)] group-hover:brightness-110 transition-all duration-150"
            format="webp"
            loading="eager"
          />
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center gap-7 text-[13px] font-medium text-slate-300">
          <a href="#tratamentos" class="hover:text-gold-200 transition-colors duration-150">Tratamentos</a>
          <a href="#anatomia" class="hover:text-gold-200 transition-colors duration-150">Anatomia 3D</a>
          <a href="#sobre" class="hover:text-gold-200 transition-colors duration-150">Sobre o Dr. Luciano</a>
          <a href="#avaliacoes" class="hover:text-gold-200 transition-colors duration-150">Avaliações</a>
          <a href="#faq" class="hover:text-gold-200 transition-colors duration-150">Dúvidas</a>
          <a href="#localizacao" class="hover:text-gold-200 transition-colors duration-150">Localização</a>
        </nav>

        <!-- CTA Header -->
        <div class="flex items-center gap-3">
          <span class="hidden xl:inline-flex items-center text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-gold-400/12 text-gold-300 border border-gold-400/25">
            CRO-MG 25170
          </span>
          <a
            href={heroWhatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-tactile inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-whatsapp text-slate-950 font-bold text-xs shadow-md hover:bg-whatsapp-hover transition-colors duration-150"
            aria-label="Agendar Avaliação via WhatsApp"
          >
            <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
            <span class="hidden sm:inline">Agendar Avaliação</span>
            <span class="sm:hidden">Agendar</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- =========================================================================
       HERO SECTION: MINIMALISTA, EDITORIAL & ALTO PADRÃO COM BEAMS ANIMATION
       - Fundo dinâmico com feixes de luz interativos (BeamsBackground)
       - Consultório removido conforme solicitado
       - Imagem do Dr. Luciano 100% transparente com acabamento premium
       ========================================================================= -->
  <section class="relative bg-[#090E17] min-h-[640px] lg:min-h-[760px] flex items-center overflow-hidden border-b border-slate-800/80">
    
    <!-- Animação Beams no Fundo (100% Fluida, Sem Foto de Consultório) -->
    <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
      <BeamsBackground client:load intensity="subtle" className="w-full h-full min-h-0 bg-[#090E17]" />
      <!-- Vinheta sutil de profundidade -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#090E17] via-transparent to-[#090E17]/50 pointer-events-none"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-10 pb-16 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Coluna de Conteúdo Editorial (Esquerda) -->
        <div class="lg:col-span-7 flex flex-col justify-center text-left">
          
          <!-- Eyebrow Discreto & Elegante -->
          <div class="hero-entrance-1 inline-flex items-center gap-2 self-start px-3.5 py-1.5 rounded-full bg-slate-900/80 border border-gold-400/25 text-gold-300 text-[11px] font-semibold tracking-wider uppercase backdrop-blur-md mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
            <span>Implantodontia e Reabilitação Oral</span>
          </div>

          <!-- Headline H1 Editorial -->
          <h1 class="hero-entrance-2 font-serif text-3xl sm:text-4xl md:text-5xl lg:text-[3.15rem] font-bold text-white tracking-tight leading-[1.18] mb-6 max-w-2xl">
            A arte e a precisão de voltar a sorrir com <span class="italic font-normal text-gold-200">dentes fixos e segurança</span>.
          </h1>

          <!-- Subtítulo Enxuto & Transparente -->
          <p class="hero-entrance-3 text-base sm:text-lg text-slate-300/90 leading-relaxed mb-8 max-w-xl font-light">
            Especialista em implantes dentários com planejamento digital guiado, tecnologia sem dor e atendimento conduzido pessoalmente pelo <strong class="text-white font-medium">Dr. Luciano Freire</strong> em Passos, MG.
          </p>

          <!-- CTAs Alinhados e Sem Excesso -->
          <div class="hero-entrance-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-3">
            <a
              href={heroWhatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-tactile btn-shimmer inline-flex items-center justify-center gap-3 px-7 py-4 rounded-xl bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold text-sm sm:text-base shadow-[0_4px_24px_rgba(37,211,102,0.28)]"
            >
              <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
              </svg>
              <span>Agendar Avaliação no WhatsApp</span>
            </a>

            <a
              href="#tratamentos"
              class="btn-tactile inline-flex items-center justify-center gap-2 px-5 py-4 rounded-xl text-slate-300 hover:text-white font-medium text-sm transition-colors border border-slate-800/80 hover:border-slate-700 bg-slate-900/40"
            >
              <span>Conhecer tratamentos</span>
              <svg class="w-4 h-4 text-gold-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </a>
          </div>

          <p class="hero-entrance-4 text-xs text-slate-400 mb-8 font-light flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Atendimento acolhedor e individual • Avaliação tranquila e sem compromisso</span>
          </p>

          <!-- Faixa Unificada de Confiança & Autoridade (Substitui os cards soltos) -->
          <div class="hero-entrance-5 pt-6 border-t border-slate-800/80 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-slate-400">
            <div class="flex items-center gap-2">
              <div class="flex items-center gap-0.5 text-gold-400">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              </div>
              <span class="text-slate-200 font-medium">5.0 no Google <span class="text-slate-400 font-normal">(13+ avaliações)</span></span>
            </div>
            <span class="text-slate-600 hidden sm:inline">•</span>
            <div class="flex items-center gap-1.5">
              <span class="text-gold-300 font-semibold">20+ Anos</span>
              <span>de atuação</span>
            </div>
            <span class="text-slate-600 hidden sm:inline">•</span>
            <div class="text-slate-300 font-medium">
              CRO-MG 25170
            </div>
          </div>

        </div>

        <!-- Coluna da Direita (Dr. Luciano em harmonia, sem caixas flutuantes poluindo) -->
        <div class="lg:col-span-5 relative flex justify-center lg:justify-end items-end min-h-[460px] sm:min-h-[520px] lg:min-h-[640px]">
          
          <!-- Brilho Dourado Suave e Natural Atrás do Médico -->
          <div class="absolute bottom-12 right-1/2 translate-x-1/2 lg:translate-x-0 lg:right-6 w-72 h-72 rounded-full bg-gold-400/[0.07] blur-3xl pointer-events-none"></div>

          <!-- Retrato com Máscara de Fade Suave no Rodapé -->
          <div class="hero-doctor-entrance relative w-full max-w-sm sm:max-w-md lg:max-w-lg flex justify-center lg:justify-end [mask-image:linear-gradient(to_bottom,black_86%,transparent_100%)]">
            <Image
              src={drLucianoHeroImg}
              alt="Dr. Luciano Alves Freire - Especialista em Implantes Dentários e Reabilitação Oral em Passos MG"
              class="w-auto h-[440px] sm:h-[500px] lg:h-[620px] object-contain drop-shadow-[0_15px_35px_rgba(0,0,0,0.85)] select-none pointer-events-none animate-float-slow"
              widths={[380, 520, 720]}
              sizes="(max-width: 640px) 380px, (max-width: 1024px) 500px, 620px"
              format="webp"
              quality={88}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- =========================================================================
       DOBRA 2: SEÇÃO COMPARATIVA INTERATIVA — ANATOMIA & IMPLANTE DENTAL
       - Fim dos cartões dentro de cartões (Zero SaaS)
       - Slider de revelação interativo com hardware acceleration
       - Dossiê editorial com linhas finas e tipografia médica de luxo
       ========================================================================= -->
  <section id="anatomia" class="relative bg-[#080D16] py-20 lg:py-28 border-t border-b border-slate-800/80 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Cabeçalho Editorial Aberto (Sem caixas) -->
      <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-20" data-reveal>
        <span class="text-xs font-semibold tracking-wider text-gold-400 uppercase">
          Comparativo Anatômico
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight mt-2 mb-5">
          Tão Firme e Natural Quanto a Sua Própria Raiz
        </h2>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-light max-w-2xl mx-auto">
          Arraste o divisor central para ver como a implantodontia moderna substitui o dente perdido com perfeição — devolvendo a firmeza da mastigação sem desgastar nenhum dente saudável ao lado.
        </p>
      </div>

      <!-- Layout Editorial em 2 Colunas: Slider Interativo + Dossiê Clínico -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center mb-16">
        
        <!-- Coluna da Esquerda: Slider Interativo Deslize para Revelar -->
        <div class="lg:col-span-6 flex flex-col items-center justify-center" data-reveal data-reveal-delay="100">
          <AnatomyComparisonSlider
            client:visible
            naturalSrc={denteNaturalImg.src}
            implantSrc={implanteTitanioImg.src}
          />
          <p class="text-[11px] text-slate-400 text-center mt-3 font-light">
            Arraste para comparar: dente biológico à esquerda e implante fixo de titânio à direita.
          </p>
        </div>

        <!-- Coluna da Direita: Dossiê Editorial Clínico (Zero cartões fechados) -->
        <div class="lg:col-span-6 flex flex-col justify-center" data-reveal data-reveal-delay="200">
          
          <div class="space-y-8">
            
            <!-- Item 1: Coroa -->
            <div class="pb-6 border-b border-slate-800/80">
              <div class="flex items-baseline gap-3 mb-2">
                <span class="font-serif text-lg font-bold text-gold-300">01</span>
                <h3 class="font-serif text-xl font-bold text-white">
                  Porcelana Pura que Não Mancha e Não Amarela
                </h3>
              </div>
              <p class="text-slate-300 text-sm leading-relaxed pl-7 font-light">
                A coroa confeccionada sob medida pelo Dr. Luciano utiliza cerâmica nobre de altíssima qualidade. Ela reproduz a mesma cor, brilho e força do esmalte natural e, diferentemente de resinas simples, não amarela com café, vinho ou com o passar dos anos.
              </p>
            </div>

            <!-- Item 2: Conexão & Ausência de Cáries -->
            <div class="pb-6 border-b border-slate-800/80">
              <div class="flex items-baseline gap-3 mb-2">
                <span class="font-serif text-lg font-bold text-gold-300">02</span>
                <h3 class="font-serif text-xl font-bold text-white">
                  Fim da Dor de Dente e do Tratamento de Canal
                </h3>
              </div>
              <p class="text-slate-300 text-sm leading-relaxed pl-7 font-light">
                O dente danificado sofre com cáries e nervos inflamados que causam dor intensa. Já o implante de titânio é uma raiz pura, biológica e definitiva: nunca terá cárie, infecção de nervo ou aquela dor de dente incômoda.
              </p>
            </div>

            <!-- Item 3: Estímulo Ósseo e Preservação Facial -->
            <div class="pb-2">
              <div class="flex items-baseline gap-3 mb-2">
                <span class="font-serif text-lg font-bold text-gold-300">03</span>
                <h3 class="font-serif text-xl font-bold text-white">
                  Mastigação Firme e Preservação do Rosto
                </h3>
              </div>
              <p class="text-slate-300 text-sm leading-relaxed pl-7 font-light">
                O pino de titânio se funde com total firmeza ao osso. Ao mastigar, a força natural estimula a mandíbula e impede que o osso facial encolha com a idade — mantendo a sustentação dos lábios e a jovialidade do seu rosto.
              </p>
            </div>

          </div>

          <!-- Ação Rápida WhatsApp -->
          <div class="mt-8 pt-6 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs text-slate-400 font-light">
              Dúvidas se o seu caso tem indicação?
            </span>
            <a
              href={`${whatsappBaseUrl}?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20tirar%20d%C3%BAvidas%20sobre%20a%20anatomia%20do%20implante.`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-tactile inline-flex items-center gap-2 text-xs font-bold text-gold-300 hover:text-gold-200"
            >
              <span>Perguntar ao Dr. Luciano</span>
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>

        </div>

      </div>



    </div>
  </section>

  <!-- =========================================================================
       DOBRA 3: SEU MOMENTO CLÍNICO & JORNADA DA TRANQUILIDADE (SOLUÇÃO 1 + 3)
       - Fim dos cartões genéricos tipo SaaS
       - Navegador interativo por situação real do paciente com CTA personalizado
       - Jornada em 3 passos eliminando o medo da dor com parecer do especialista
       ========================================================================= -->
  <section id="tratamentos" class="relative bg-slate-950 py-20 lg:py-28 text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Cabeçalho da Seção -->
      <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16" data-reveal>
        <span class="text-xs font-semibold tracking-wider text-gold-400 uppercase">
          Seu Momento Clínico
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight mt-2 mb-4">
          Como Podemos Te Ajudar a Voltar a Sorrir com Segurança?
        </h2>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          Selecione a sua situação abaixo para entender o caminho exato para dentes fixos, o que você sente hoje e como o Dr. Luciano conduz o tratamento sem dor.
        </p>
      </div>

      <!-- Componente Interativo: Navegador por Situação do Paciente (Solução 1) -->
      <div class="mb-20" data-reveal data-reveal-delay="100">
        <PatientSituationNavigator client:visible whatsappBaseUrl={whatsappBaseUrl} />
      </div>

      <!-- PARTE 2: Trilha Cirúrgica Contínua (Opção 3 - Fim do Medo da Dor) -->
      <div class="pt-12 border-t border-slate-800/80">
        
