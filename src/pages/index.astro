---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import drLucianoImg from '../assets/dr-luciano-freire.png';
import drLucianoHeroImg from '../assets/dr-luciano-freire-hero.png';
import clinicBgHeroImg from '../assets/clinic-bg-hero.jpg';
import logoClinica from '../assets/logo-clinica-nobg.png';
import denteNaturalImg from '../assets/dente-natural-comparativo.png';
import implanteTitanioImg from '../assets/implante-titanio-comparativo.png';
import ServicesCarousel from '../components/ServicesCarousel';
import { AnatomyComparisonSlider } from '../components/AnatomyComparisonSlider';
import { getImage } from 'astro:assets';

import implanteImg from '../assets/servico_implante.jpg';
import protocoloImg from '../assets/servico_protocolo.jpg';
import esteticaImg from '../assets/servico_estetica.jpg';
import ortodontiaImg from '../assets/servico_ortodontia.jpg';

const optimizedNaturalImg = await getImage({ src: denteNaturalImg, format: 'webp', width: 500 });
const optimizedImplantImg = await getImage({ src: implanteTitanioImg, format: 'webp', width: 500 });

const optImplante = await getImage({ src: implanteImg, format: 'webp', width: 600 });
const optProtocolo = await getImage({ src: protocoloImg, format: 'webp', width: 600 });
const optEstetica = await getImage({ src: esteticaImg, format: 'webp', width: 600 });
const optOrtodontia = await getImage({ src: ortodontiaImg, format: 'webp', width: 600 });

const carouselServices = [
  { id: 'implantes', title: 'Implantes Dentários', description: 'Substitua raízes perdidas com pinos de titânio. Firmeza absoluta e estética natural sem desgastar dentes vizinhos.', href: '/servicos/implantes', imageSrc: optImplante.src },
  { id: 'protocolo', title: 'Prótese Protocolo', description: 'Livre-se da dentadura móvel. Todos os dentes fixos sobre apenas 4 a 6 implantes em poucos dias.', href: '/servicos/protocolo', imageSrc: optProtocolo.src },
  { id: 'estetica', title: 'Estética Dental', description: 'Facetas em porcelana, lentes de contato dental e clareamento para um sorriso harmonioso e iluminado.', href: '/servicos/estetica', imageSrc: optEstetica.src },
  { id: 'ortodontia', title: 'Ortodontia Invisível', description: 'Alinhadores transparentes que corrigem a posição dos dentes com máximo conforto e discrição.', href: '/servicos/ortodontia', imageSrc: optOrtodontia.src },
];

const whatsappBaseUrl = "https://wa.me/5535988215162";
const heroWhatsappUrl = `${whatsappBaseUrl}?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o%20de%20implante%20dent%C3%A1rio`;
const phoneFixed = "(35) 3521-5027";
const phoneFixedClean = "553535215027";
const currentYear = new Date().getFullYear();
---

<Layout>
  <!-- SPLASH SCREEN -->
  <div id="splash-screen" class="fixed inset-0 z-[100] bg-babyblue-50 flex flex-col items-center justify-center transition-colors duration-700">
    <div id="splash-logo-container" class="relative w-48 sm:w-64 transition-transform duration-[1000ms] ease-[cubic-bezier(0.2,0.8,0.2,1)] origin-center">
      <!-- Dimmed logo -->
      <Image src={logoClinica} alt="Logo" class="w-full h-auto object-contain opacity-20" format="webp" loading="eager" />
      <!-- Illuminated logo with clip-path sweep -->
      <div id="splash-logo-lit" class="absolute inset-0 overflow-hidden" style="clip-path: inset(0 0 100% 0);">
        <Image src={logoClinica} alt="Logo" class="w-full h-auto object-contain" format="webp" loading="eager" />
      </div>
    </div>
  </div>

  <!-- HEADER -->
  <Header />

  <main id="main-content">
  <!-- 1. HERO -->
  <section id="hero" class="relative min-h-[640px] lg:min-h-[760px] flex items-center overflow-hidden border-b border-slate-200 bg-babyblue-50">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <Image
        src={clinicBgHeroImg}
        alt="Consultório Odontológico de Alto Padrão"
        class="w-full h-full object-cover object-center"
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-babyblue-50/90"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-10 pb-16 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-7 flex flex-col justify-center text-center lg:text-left items-center lg:items-start pt-8">
          <div class="hero-entrance-1 mb-6">
            <div class="inline-flex items-center gap-x-2 py-1.5 px-3 rounded-full bg-white/80 border border-slate-200 text-xs text-slate-600 shadow-sm backdrop-blur-sm">
              <div class="flex items-center gap-0.5 text-gold-400">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              </div>
              <span class="text-slate-900 font-bold text-[11px] sm:text-xs">5.0 Estrelas • Passos/MG</span>
            </div>
          </div>
          <h1 class="hero-entrance-2 font-sans text-3xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.18] mb-4 max-w-2xl">
            Volte a sorrir com confiança e a viver seus melhores momentos.
          </h1>
          <p class="hero-entrance-3 text-base sm:text-lg text-slate-600 leading-relaxed mb-8 max-w-xl font-normal">
            Descubra o poder de um sorriso renovado. Conforto, estética e bem-estar em um atendimento exclusivo conduzido pessoalmente pelo <strong class="text-slate-900 font-bold">Dr. Luciano Freire</strong>.
          </p>
          <div class="hero-entrance-4 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-10 lg:mb-4">
            <a href={heroWhatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-tactile btn-shimmer inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold text-base shadow-[0_4px_24px_rgba(37,211,102,0.28)] w-full transition-colors">
              <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
              <span>Agendar Avaliação no WhatsApp</span>
            </a>
          </div>
          <div class="block lg:hidden w-full max-w-[280px] mx-auto hero-entrance-5">
            <div class="relative flex justify-center items-end" style="mask-image: linear-gradient(to bottom, black 60%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);">
              <Image src={drLucianoHeroImg} alt="Dr. Luciano Alves Freire" class="w-auto h-[350px] object-contain drop-shadow-[0_12px_28px_rgba(0,0,0,0.85)] select-none pointer-events-none" widths={[300, 420]} sizes="(max-width: 640px) 280px, 320px" format="webp" quality={88} loading="eager" />
            </div>
          </div>
        </div>
        <div class="hidden lg:flex lg:col-span-5 relative justify-end items-end min-h-[500px]">
          <div class="hero-doctor-entrance relative w-full flex justify-end" style="mask-image: linear-gradient(to bottom, black 60%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);">
            <Image src={drLucianoHeroImg} alt="Dr. Luciano Alves Freire" class="w-auto h-[550px] object-contain drop-shadow-[0_15px_35px_rgba(0,0,0,0.85)] select-none pointer-events-none animate-float-slow" widths={[380, 520]} sizes="520px" format="webp" quality={88} loading="eager" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. TRIAGEM / SERVIÇOS (A ser atualizado) -->
  <section id="triagem" class="relative bg-white py-20 lg:py-28 text-slate-900 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16" data-reveal>
        <span class="text-xs font-semibold tracking-wider text-gold-700 uppercase">Tratamentos Especializados</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight mt-2 mb-4">
          Como Podemos Te Ajudar a Voltar a Sorrir com Segurança?
        </h2>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
          Selecione a sua situação abaixo para entender as possibilidades de tratamentos, as indicações clínicas e como o Dr. Luciano conduz cada etapa com foco no seu conforto.
        </p>
      </div>
      <div class="mb-10 w-full" data-reveal data-reveal-delay="100">
        <ServicesCarousel client:visible services={carouselServices} />
      </div>
    </div>
  </section>

  <!-- 3. COMPARADOR & BENEFICIOS -->
  <section id="comparador" class="relative bg-babyblue-50 py-20 lg:py-28 border-b border-slate-200 text-slate-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16" data-reveal>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold-50 text-gold-700 text-xs font-bold uppercase tracking-wider border border-gold-200 mb-3">
          Tecnologia e Anatomia
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight mb-4">
          Firmeza e Segurança Semelhantes à Sua Própria Raiz
        </h2>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto font-normal">
          Arraste o comparador para ver como o implante substitui o dente com alta precisão estética e funcional — devolvendo a firmeza da mastigação sem desgastar nenhum dente saudável ao lado.
        </p>
      </div>
      <div class="flex flex-col items-center justify-center mb-20" data-reveal data-reveal-delay="100">
        <div class="p-2 sm:p-3 rounded-3xl bg-slate-50 border border-slate-200 shadow-xl w-full max-w-[440px]">
          <AnatomyComparisonSlider client:visible naturalSrc={optimizedNaturalImg.src} implantSrc={optimizedImplantImg.src} />
        </div>
        <p class="text-xs text-slate-700 text-center mt-3 font-medium">
          Arraste para comparar: dente biológico à esquerda e implante fixo de titânio à direita.
        </p>
        <a href={heroWhatsappUrl} target="_blank" rel="noopener noreferrer" class="mt-4 text-gold-600 hover:text-gold-500 text-sm font-bold transition-colors flex items-center gap-1 group">
          Quero avaliar meu caso no WhatsApp <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <!-- CARDS FUSION -->
      <div class="max-w-4xl mx-auto" data-reveal data-reveal-delay="200">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="pl-6 border-l-2 border-gold-400/50 py-2 group">
            <div class="flex items-center gap-2 mb-3">
              <h3 class="font-serif text-lg font-bold text-slate-900">Sorria sem esconder a boca</h3>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">Acabamento em porcelana que não amarela nem mancha com café ou vinho. Brilho e textura muito semelhantes ao esmalte natural.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold-400/50 py-2 group">
            <div class="flex items-center gap-2 mb-3">
              <h3 class="font-serif text-lg font-bold text-slate-900">Mastigue sem medo de quebrar</h3>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">A base de titânio devolve a força necessária para mastigar alimentos firmes. Firmeza definitiva para o seu dia a dia.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold-400/50 py-2 group">
            <div class="flex items-center gap-2 mb-3">
              <h3 class="font-serif text-lg font-bold text-slate-900">Sinta o sabor real da comida</h3>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">Céu da boca totalmente livre. Sem placas acrílicas cobrindo o palato, permitindo sentir o sabor e a temperatura dos alimentos.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. JORNADA -->
  <section id="jornada" class="relative bg-white py-20 lg:py-28 border-b border-slate-200 text-slate-600">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14" data-reveal>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold-50 text-gold-700 text-xs font-bold uppercase tracking-wider border border-gold-200 mb-3">Sua Jornada</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight mt-2 mb-4">O Fim do Medo: Um Passo a Passo Sem Dor</h2>
        <p class="text-slate-600 text-base leading-relaxed max-w-xl mx-auto">Esqueça os procedimentos antigos. Conheça as três etapas para ter seu sorriso de volta com máximo conforto.</p>
      </div>
      <div class="relative max-w-2xl mx-auto pb-8" id="jornada-timeline">
        {/* Static Base Line */}
        <div class="absolute left-6 top-2 bottom-2 w-1 bg-slate-200 rounded-full"></div>
        
        {/* Animated Light Line */}
        <div id="jornada-progress-line" class="absolute left-6 top-2 bottom-2 w-1 bg-amber-400 rounded-full shadow-[0_0_12px_#fbbf24] z-10"></div>

        <div class="space-y-16">
          <div class="relative group pl-16 jornada-step" data-reveal data-reveal-delay="75">
            <div class="absolute left-[19px] top-1.5 w-3.5 h-3.5 rounded-full bg-amber-400 border-2 border-amber-200 shadow-[0_0_12px_#fbbf24] z-20 step-dot"></div>
            <div>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 mb-2">Passo 01: Diagnóstico Digital 3D</h3>
              <p class="text-slate-600 text-base leading-relaxed">Mapeamento minucioso do sorriso sem o desconforto de moldagens antigas.</p>
            </div>
          </div>
          <div class="relative group pl-16 jornada-step" data-reveal data-reveal-delay="150">
            <div class="absolute left-[19px] top-1.5 w-3.5 h-3.5 rounded-full bg-amber-400 border-2 border-amber-200 shadow-[0_0_12px_#fbbf24] z-20 step-dot"></div>
            <div>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 mb-2">Passo 02: Cirurgia Guiada e Sem Dor</h3>
              <p class="text-slate-600 text-base leading-relaxed">Procedimento planejado com anestesia moderna para total previsibilidade e conforto.</p>
            </div>
          </div>
          <div class="relative group pl-16 jornada-step" data-reveal data-reveal-delay="225">
            <div class="absolute left-[19px] top-1.5 w-3.5 h-3.5 rounded-full bg-amber-400 border-2 border-amber-200 shadow-[0_0_12px_#fbbf24] z-20 step-dot"></div>
            <div>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 mb-2">Passo 03: Instalação dos Dentes Fixos</h3>
              <p class="text-slate-600 text-base leading-relaxed">Prótese definitiva posicionada para devolver a mastigação e a liberdade de sorrir.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. AUTORIDADE -->
  <section id="autoridade" class="relative bg-babyblue-50 py-16 sm:py-24 border-b border-slate-200 text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="block lg:hidden text-center mb-8" data-reveal>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold-400/15 text-gold-700 text-xs font-bold uppercase tracking-wider border border-gold-400/30 mb-2">Trajetória e Compromisso</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight mt-2 mb-4">Atendimento Pessoal do Início ao Fim</h2>
        <p class="text-slate-600 text-base leading-relaxed px-4">Com mais de 20 anos de atuação clínica no Centro de Passos, o Dr. Luciano Alves Freire (CRO-MG 25170) conduz pessoalmente cada etapa do seu tratamento, do diagnóstico inicial à reabilitação final.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
        <div class="lg:col-span-5 flex justify-center" data-reveal data-reveal-delay="100">
          <div class="relative w-full max-w-[270px] sm:max-w-xs lg:max-w-md">
            <div class="relative rounded-2xl overflow-hidden bg-slate-50 border border-slate-200 shadow-xl card-tactile">
              <Image src={drLucianoImg} alt="Dr. Luciano Alves Freire - Cirurgião-Dentista CRO-MG 25170 em Passos MG" class="w-full h-auto object-cover" widths={[360, 500]} sizes="(max-width: 768px) 270px, 450px" format="webp" loading="lazy" />
              <div class="p-3.5 sm:p-4 bg-white/95 border-t border-slate-200 text-center">
                <p class="font-serif font-bold text-slate-900 text-base">Dr. Luciano Alves Freire</p>
                <p class="text-xs text-gold-700 font-semibold">Cirurgião-Dentista • CRO-MG 25170</p>
              </div>
            </div>
          </div>
        </div>
        <div class="lg:col-span-7 flex flex-col justify-center" data-reveal data-reveal-delay="200">
          <div class="hidden lg:block">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold-400/15 text-gold-700 text-xs font-bold uppercase tracking-wider border border-gold-400/30 mb-3">Trajetória e Compromisso</span>
            <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight mt-2 mb-4">Diagnóstico Preciso e Atendimento Conduzido Pessoalmente</h2>
            <p class="text-slate-600 text-lg leading-relaxed mb-8 max-w-2xl">Com mais de 20 anos de atuação clínica no Centro de Passos, o Dr. Luciano Alves Freire (CRO-MG 25170) conduz pessoalmente cada etapa do seu tratamento, do diagnóstico inicial à reabilitação final.</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 shadow-sm card-tactile">
              <div class="text-gold-700 font-bold text-xl mb-1">20+ Anos</div>
              <div class="text-xs font-bold text-slate-900 mb-0.5">Prática Clínica</div>
              <p class="text-xs text-slate-600 leading-normal">Milhares de reabilitações em Passos/MG.</p>
