              /* Setas de Navegação do Carrossel */
              [class*="CarouselArrowControlContainer"],
              [class*="CarouselArrow"] {
                background-color: #0f172a !important;
                border: 1px solid #334155 !important;
                color: #C5A880 !important;
                box-shadow: 0 4px 14px rgba(0, 0, 0, 0.7) !important;
                border-radius: 9999px !important;
                width: 36px !important;
                height: 36px !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                transition: all 0.2s ease !important;
              }

              [class*="CarouselArrowControlContainer"][disabled],
              [class*="CarouselArrowControlContainer"][class*="disabled"],
              [class*="CarouselArrowControlContainer"]:has([disabled]) {
                opacity: 0 !important;
                pointer-events: none !important;
              }

              [class*="CarouselArrowControlContainer"]:hover,
              [class*="CarouselArrow"]:hover {
                background-color: #1e293b !important;
                border-color: #D4AF37 !important;
                color: #FAF6EE !important;
              }

              /* Indicadores (Dots) */
              [class*="Carousel__Dot"],
              [class*="CarouselDots"] button {
                background-color: #334155 !important;
