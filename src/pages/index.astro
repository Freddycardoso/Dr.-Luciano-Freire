            const darkElfsightCSS = `
              /* ========================================================
                 PALETA DARK LUXURY SLATE & GOLD PARA O WIDGET GOOGLE REVIEWS
                 ======================================================== */
              :host, * {
                font-family: inherit !important;
              }

              /* Oculta título redundante externo em inglês caso apareça */
              [class*="WidgetTitle__Header"],
              [class*="HeaderTitle__Title"],
              [class*="HeaderTitle"] {
                display: none !important;
              }

              /* Cabeçalho do Widget (Google Reviews 5.0) */
              [class*="HeaderContainer__Inner"],
              [class*="Header__HeaderContainer"],
              [class*="HeaderStyle"] {
                background-color: #0f172a !important; /* slate-900 */
                border: 1px solid #1e293b !important; /* slate-800 */
                border-radius: 1.25rem !important;
                box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7) !important;
                color: #ffffff !important;
              }

              /* Textos de Nota e Avaliação do Cabeçalho */
              [class*="HeaderRating__Rating"],
              [class*="HeaderRatingText__RatingValue"],
              [class*="RatingNumber"],
              [class*="RatingValue"],
              [class*="HeaderRatingText"],
              [class*="HeaderTextWithSource__Text"],
              [class*="TotalScore"] {
                color: #ffffff !important;
                fill: #ffffff !important;
              }

              [class*="HeaderTextWithSource"] span,
              [class*="HeaderTextWithSource"] text {
                color: #ffffff !important;
                fill: #ffffff !important;
              }

              [class*="HeaderRating__ReviewsCount"],
              [class*="TotalReviews"] {
                color: #94a3b8 !important; /* slate-400 */
              }

              /* Botão de Avaliar: Dourado com texto em Português */
              [class*="HeaderWriteReviewButton"],
              [class*="ButtonBase__ButtonContainer"],
              [class*="WriteReviewButton"],
              [class*="WriteReviewButton__Component"] {
                background: linear-gradient(135deg, #C5A880 0%, #D4AF37 100%) !important;
                color: #090E17 !important;
                border: 1px solid rgba(212, 175, 55, 0.6) !important;
                border-radius: 0.75rem !important;
                box-shadow: 0 4px 15px rgba(212, 175, 55, 0.25) !important;
                font-weight: 700 !important;
                letter-spacing: 0.02em !important;
                transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
                font-size: 0 !important;
                padding: 0.65rem 1.25rem !important;
                cursor: pointer !important;
              }

              [class*="HeaderWriteReviewButton"]::after,
              [class*="ButtonBase__ButtonContainer"]::after,
              [class*="WriteReviewButton"]::after,
              [class*="WriteReviewButton__Component"]::after {
                content: "Avaliar no Google" !important;
                font-size: 0.8125rem !important;
                font-weight: 700 !important;
                color: #090E17 !important;
                display: inline-block !important;
              }

              [class*="HeaderWriteReviewButton"]:hover,
              [class*="ButtonBase__ButtonContainer"]:hover,
              [class*="WriteReviewButton"]:hover {
                background: #E6D7BE !important;
                box-shadow: 0 6px 20px rgba(212, 175, 55, 0.45) !important;
                transform: translateY(-1px) !important;
              }

              /* Cards de Avaliação em Dark Slate com Borda Sutil */
              [class*="ReviewBackground__Container"],
              [class*="ReviewContainer__Inner"],
              [class*="Review__ReviewContainer"],
              [class*="ReviewComponent__ReviewContainer"] {
                background-color: #0f172a !important; /* slate-900 */
                border: 1px solid #1e293b !important; /* slate-800 */
                border-radius: 1.25rem !important;
                box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.6) !important;
                color: #cbd5e1 !important; /* slate-300 */
                transition: transform 0.2s ease, border-color 0.2s ease !important;
