  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const splashScreen = document.getElementById('splash-screen');
      const splashLogoContainer = document.getElementById('splash-logo-container');
      const litLogo = document.getElementById('splash-logo-lit');
      const headerLogoImg = document.getElementById('header-logo-img');
      
      // Removed prefers-reduced-motion check since it caused animations to not run at all on many Windows PCs
      if (splashScreen && litLogo && headerLogoImg) {
        // Calculate scrollbar width
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        
        // Prevent scrolling during splash and add padding to compensate for scrollbar loss
        document.body.style.overflow = 'hidden';
        document.body.style.paddingRight = `${scrollbarWidth}px`;
        
        // Make header logo invisible temporarily to avoid duplicate showing
        headerLogoImg.style.opacity = '0';

        // 1. Light sweep animation (top to bottom)
        setTimeout(() => {
          litLogo.style.transition = 'clip-path 1.2s cubic-bezier(0.16, 1, 0.3, 1)';
          litLogo.style.clipPath = 'inset(0 0 0 0)';
        }, 150);

        // 2. Move logo to header and fade out splash
        setTimeout(() => {
          const splashRect = splashLogoContainer.getBoundingClientRect();
          const headerRect = headerLogoImg.getBoundingClientRect();
          
          // Safe scale calculation
          const targetWidth = headerRect.width || 150;
          const currentWidth = splashRect.width || 256;
          const scale = targetWidth / currentWidth;
          
          // Center-to-center translation
          const translateX = (headerRect.left + targetWidth / 2) - (splashRect.left + currentWidth / 2);
          const translateY = (headerRect.top + (headerRect.height || 44) / 2) - (splashRect.top + (splashRect.height || 64) / 2);
          
          // Ultra-fluid Apple-like spring/ease (100% reliable, hardware-accelerated)
          const animation = splashLogoContainer.animate([
            { transform: 'translate(0px, 0px) scale(1)' },
            { transform: `translate(${translateX}px, ${translateY}px) scale(${scale})` }
          ], {
            duration: 1200,
            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            fill: 'forwards'
          });
          
          // Smoothly fade out the splash background using Web Animations API
          splashScreen.style.pointerEvents = 'none';
          splashScreen.animate([
            { backgroundColor: 'rgba(2, 6, 23, 1)' },
            { backgroundColor: 'rgba(2, 6, 23, 0)' }
          ], {
            duration: 1200,
            easing: 'ease-out',
            fill: 'forwards'
          });
          
          // Final cleanup and swap to real header logo
          animation.onfinish = () => {
            headerLogoImg.style.opacity = '1';
            splashScreen.style.opacity = '0';
            
            // Restore scrollbar and layout
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
            
            setTimeout(() => splashScreen.remove(), 100);
          };
        }, 2100);
      } else if (splashScreen) {
        splashScreen.remove();
      }
    });
  </script>
