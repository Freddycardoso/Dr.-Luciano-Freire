  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const splashScreen = document.getElementById('splash-screen');
      const splashLogoContainer = document.getElementById('splash-logo-container');
      const litLogo = document.getElementById('splash-logo-lit');
      const headerLogoImg = document.getElementById('header-logo-img');
      
      if (splashScreen && litLogo && headerLogoImg && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Prevent scrolling during splash
        document.body.style.overflow = 'hidden';
        
        // Make header logo invisible temporarily to avoid duplicate showing
        headerLogoImg.style.opacity = '0';

        // 1. Light sweep animation (top to bottom)
        setTimeout(() => {
          litLogo.style.transition = 'clip-path 1.2s cubic-bezier(0.16, 1, 0.3, 1)';
          litLogo.style.clipPath = 'inset(0 0 0 0)';
        }, 150);

        // 2. Move logo to header and fade out splash
        setTimeout(() => {
          const splashRect = splashLogoContainer.getBoundingClientRect();
          const headerRect = headerLogoImg.getBoundingClientRect();
          
          const scale = headerRect.width / splashRect.width;
          const translateX = (headerRect.left + headerRect.width / 2) - (splashRect.left + splashRect.width / 2);
          const translateY = (headerRect.top + headerRect.height / 2) - (splashRect.top + splashRect.height / 2);
          
          // Animate splash logo to header position
          splashLogoContainer.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
          
          // Make splash bg transparent
          splashScreen.style.backgroundColor = 'transparent';
          splashScreen.style.pointerEvents = 'none';
          
          // Restore scrolling
          document.body.style.overflow = '';
          
          // Final cleanup and swap to real header logo
          setTimeout(() => {
            headerLogoImg.style.opacity = '1';
            splashScreen.style.opacity = '0';
            setTimeout(() => splashScreen.remove(), 500);
          }, 1000);
        }, 2100);
      } else if (splashScreen) {
        // Fallback for reduced motion or missing elements
        splashScreen.remove();
      }
    });
  </script>
