---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import drLucianoImg from '../assets/dr-luciano-freire.png';
import drLucianoHeroImg from '../assets/dr-luciano-freire-hero.png';
import clinicBgHeroImg from '../assets/clinic-bg-hero.jpg';
import logoClinica from '../assets/logo-clinica-nobg.png';
import denteNaturalImg from '../assets/dente-natural-comparativo.png';
import implanteTitanioImg from '../assets/implante-titanio-comparativo.png';
import { PatientSituationNavigator } from '../components/PatientSituationNavigator';
import { AnatomyComparisonSlider } from '../components/AnatomyComparisonSlider';

const whatsappBaseUrl = "https://wa.me/5535988215162";
const heroWhatsappUrl = `${whatsappBaseUrl}?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o%20de%20implante%20dent%C3%A1rio`;
const phoneFixed = "(35) 3521-5027";
const phoneFixedClean = "553535215027";
const currentYear = new Date().getFullYear();
---

<Layout>
  <!-- SPLASH SCREEN -->
  <div id="splash-screen" class="fixed inset-0 z-[100] bg-slate-950 flex flex-col items-center justify-center transition-colors duration-700">
    <div id="splash-logo-container" class="relative w-48 sm:w-64 transition-transform duration-[1000ms] ease-[cubic-bezier(0.2,0.8,0.2,1)] origin-center">
      <!-- Dimmed logo -->
      <Image src={logoClinica} alt="Logo" class="w-full h-auto object-contain opacity-20" format="webp" loading="eager" />
      <!-- Illuminated logo with clip-path sweep -->
      <div id="splash-logo-lit" class="absolute inset-0 overflow-hidden" style="clip-path: inset(0 0 100% 0);">
        <Image src={logoClinica} alt="Logo" class="w-full h-auto object-contain" format="webp" loading="eager" />
      </div>
    </div>
  </div>

  <!-- HEADER -->
  <header class="sticky top-0 z-40 bg-slate-950 border-b border-slate-800/60 transition-colors duration-150">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 lg:h-[4.5rem]">
        <a href="#" class="group flex items-center focus:outline-none focus:ring-2 focus:ring-gold-400 rounded-lg btn-tactile py-1" aria-label="Dr. Luciano Alves Freire - Início">
          <Image
            id="header-logo-img"
            src={logoClinica}
            alt="Logo Dr. Luciano Alves Freire - Consultório Odontológico"
            class="h-9 sm:h-11 w-auto object-contain drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)] group-hover:brightness-110 transition-all duration-150"
            format="webp"
            loading="eager"
          />
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center gap-7 text-[13px] font-medium text-slate-300">
          <a href="#triagem" class="hover:text-gold-200 transition-colors duration-150">Tratamentos</a>
          <a href="#comparador" class="hover:text-gold-200 transition-colors duration-150">Anatomia 3D</a>
          <a href="#autoridade" class="hover:text-gold-200 transition-colors duration-150">Sobre o Dr. Luciano</a>
          <a href="#jornada" class="hover:text-gold-200 transition-colors duration-150">Jornada</a>
          <a href="#faq" class="hover:text-gold-200 transition-colors duration-150">Dúvidas</a>
          <a href="#contato" class="hover:text-gold-200 transition-colors duration-150">Localização</a>
        </nav>

        <!-- CTA Header -->
        <div class="flex items-center gap-3">
          <span class="hidden xl:inline-flex items-center text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-gold-400/12 text-gold-300 border border-gold-400/25">
            CRO-MG 25170
          </span>
          <a
            href={heroWhatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-tactile inline-flex items-center justify-center gap-2 px-4 py-2 rounded-xl bg-whatsapp text-slate-950 font-bold text-xs shadow-md hover:bg-whatsapp-hover transition-colors duration-150"
            aria-label="Agendar Avaliação via WhatsApp"
          >
            <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
            </svg>
            <span class="hidden sm:inline">Agendar Avaliação</span>
            <span class="sm:hidden">Agendar</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- 1. HERO -->
  <section id="hero" class="relative min-h-[640px] lg:min-h-[760px] flex items-center overflow-hidden border-b border-slate-800/80">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <Image
        src={clinicBgHeroImg}
        alt="Consultório Odontológico de Alto Padrão"
        class="w-full h-full object-cover object-center"
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/95 via-slate-900/85 to-slate-950"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-10 pb-16 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <div class="lg:col-span-7 flex flex-col justify-center text-center lg:text-left items-center lg:items-start pt-8">
          <div class="hero-entrance-1 mb-6">
            <div class="inline-flex items-center gap-x-2 py-1.5 px-3 rounded-full bg-slate-900/80 border border-slate-800 text-xs text-slate-300 shadow-sm backdrop-blur-sm">
              <div class="flex items-center gap-0.5 text-gold-400">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              </div>
              <span class="text-white font-bold text-[11px] sm:text-xs">5.0 Estrelas • Passos/MG</span>
            </div>
          </div>
          <h1 class="hero-entrance-2 font-sans text-3xl lg:text-5xl font-extrabold text-white tracking-tight leading-[1.18] mb-4 max-w-2xl">
            Volte a sorrir com confiança e a viver seus melhores momentos.
          </h1>
          <p class="hero-entrance-3 text-base sm:text-lg text-slate-200 leading-relaxed mb-8 max-w-xl font-normal">
            Descubra o poder de um sorriso renovado. Conforto, estética e bem-estar em um atendimento exclusivo conduzido pessoalmente pelo <strong class="text-white font-bold">Dr. Luciano Freire</strong>.
          </p>
          <div class="hero-entrance-4 flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-10 lg:mb-4">
            <a href={heroWhatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-tactile btn-shimmer inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold text-base shadow-[0_4px_24px_rgba(37,211,102,0.28)] w-full transition-colors">
              <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
              <span>Agendar Avaliação no WhatsApp</span>
            </a>
          </div>
          <div class="block lg:hidden w-full max-w-[280px] mx-auto hero-entrance-5">
            <div class="relative flex justify-center items-end" style="mask-image: linear-gradient(to bottom, black 60%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);">
              <Image src={drLucianoHeroImg} alt="Dr. Luciano Alves Freire" class="w-auto h-[350px] object-contain drop-shadow-[0_12px_28px_rgba(0,0,0,0.85)] select-none pointer-events-none" widths={[300, 420]} sizes="(max-width: 640px) 280px, 320px" format="webp" quality={88} loading="eager" />
            </div>
          </div>
        </div>
        <div class="hidden lg:flex lg:col-span-5 relative justify-end items-end min-h-[500px]">
          <div class="hero-doctor-entrance relative w-full flex justify-end" style="mask-image: linear-gradient(to bottom, black 60%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);">
            <Image src={drLucianoHeroImg} alt="Dr. Luciano Alves Freire" class="w-auto h-[550px] object-contain drop-shadow-[0_15px_35px_rgba(0,0,0,0.85)] select-none pointer-events-none animate-float-slow" widths={[380, 520]} sizes="520px" format="webp" quality={88} loading="eager" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. TRIAGEM -->
  <section id="triagem" class="relative bg-slate-950 py-20 lg:py-28 text-white border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16" data-reveal>
        <span class="text-xs font-semibold tracking-wider text-gold-400 uppercase">Seu Momento Clínico</span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white tracking-tight mt-2 mb-4">
          Como Podemos Te Ajudar a Voltar a Sorrir com Segurança?
        </h2>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          Selecione a sua situação abaixo para entender as possibilidades de dentes fixos, as indicações clínicas e como o Dr. Luciano conduz cada etapa com foco no seu conforto.
        </p>
      </div>
      <div class="mb-10" data-reveal data-reveal-delay="100">
        <PatientSituationNavigator client:visible whatsappBaseUrl={whatsappBaseUrl} />
      </div>
    </div>
  </section>

  <!-- 3. COMPARADOR & BENEFICIOS -->
  <section id="comparador" class="relative bg-white py-20 lg:py-28 border-b border-slate-200 text-slate-600">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16" data-reveal>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold-400/15 text-gold-700 text-xs font-bold uppercase tracking-wider border border-gold-400/30 mb-3">
          Tecnologia e Anatomia
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 tracking-tight mb-4">
          Tão Firme e Natural Quanto a Sua Própria Raiz
        </h2>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto font-normal">
          Arraste o comparador para ver como o implante substitui o dente com perfeição — devolvendo a firmeza total da mastigação sem desgastar nenhum dente saudável ao lado.
        </p>
      </div>
      <div class="flex flex-col items-center justify-center mb-20" data-reveal data-reveal-delay="100">
        <div class="p-2 sm:p-3 rounded-3xl bg-slate-50 border border-slate-200 shadow-xl w-full max-w-[440px]">
          <AnatomyComparisonSlider client:visible naturalSrc={denteNaturalImg.src} implantSrc={implanteTitanioImg.src} />
        </div>
        <p class="text-xs text-slate-500 text-center mt-3 font-medium">
          Arraste para comparar: dente biológico à esquerda e implante fixo de titânio à direita.
        </p>
        <a href={heroWhatsappUrl} target="_blank" rel="noopener noreferrer" class="mt-4 text-gold-600 hover:text-gold-500 text-sm font-bold transition-colors flex items-center gap-1 group">
          Quero avaliar meu caso no WhatsApp <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

      <!-- CARDS FUSION -->
      <div class="max-w-4xl mx-auto" data-reveal data-reveal-delay="200">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="pl-6 border-l-2 border-gold-400/50 py-2 group">
            <div class="flex items-center gap-2 mb-3">
              <h3 class="font-serif text-lg font-bold text-slate-900">Sorria sem esconder a boca</h3>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">Acabamento em porcelana que não amarela nem mancha com café ou vinho. O mesmo brilho e textura do esmalte natural.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold-400/50 py-2 group">
            <div class="flex items-center gap-2 mb-3">
              <h3 class="font-serif text-lg font-bold text-slate-900">Mastigue sem medo de quebrar</h3>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">A base de titânio devolve a força necessária para mastigar alimentos firmes. Firmeza definitiva para o seu dia a dia.</p>
          </div>
          <div class="pl-6 border-l-2 border-gold-400/50 py-2 group">
            <div class="flex items-center gap-2 mb-3">
              <h3 class="font-serif text-lg font-bold text-slate-900">Sinta o sabor real da comida</h3>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">Céu da boca totalmente livre. Sem placas acrílicas cobrindo o palato, permitindo sentir o sabor e a temperatura dos alimentos.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. JORNADA -->
  <section id="jornada" class="relative bg-slate-950 py-20 lg:py-28 border-b border-slate-800 text-slate-300">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14" data-reveal>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold-400/10 text-gold-300 text-xs font-bold uppercase tracking-wider border border-gold-400/20 mb-3">Sua Jornada</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white tracking-tight mt-2 mb-4">O Fim do Medo: Um Passo a Passo Sem Dor</h2>
        <p class="text-slate-400 text-base leading-relaxed max-w-xl mx-auto">Esqueça os procedimentos antigos. Conheça as três etapas para ter seu sorriso de volta com máximo conforto.</p>
      </div>
      <div class="relative max-w-2xl mx-auto space-y-16 pb-8" id="jornada-timeline">
        {/* Static Base Line */}
        <div class="absolute left-6 top-2 bottom-2 w-1 bg-slate-800 rounded-full"></div>
        
        {/* Animated Light Line */}
        <div id="jornada-progress-line" class="absolute left-6 top-2 bottom-2 w-1 bg-amber-400 rounded-full shadow-[0_0_12px_#fbbf24] z-10"></div>

        <div class="relative group pl-16 jornada-step" data-reveal data-reveal-delay="75">
          <div class="absolute left-[19px] top-1.5 w-3.5 h-3.5 rounded-full bg-amber-400 border-2 border-amber-200 shadow-[0_0_12px_#fbbf24] z-20 step-dot"></div>
          <div>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-white mb-2">Passo 01: Diagnóstico Digital 3D</h3>
            <p class="text-slate-400 text-base leading-relaxed">Mapeamento minucioso do sorriso sem o desconforto de moldagens antigas.</p>
          </div>
        </div>
        <div class="relative group pl-16 jornada-step" data-reveal data-reveal-delay="150">
          <div class="absolute left-[19px] top-1.5 w-3.5 h-3.5 rounded-full bg-amber-400 border-2 border-amber-200 shadow-[0_0_12px_#fbbf24] z-20 step-dot"></div>
          <div>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-white mb-2">Passo 02: Cirurgia Guiada e Sem Dor</h3>
            <p class="text-slate-400 text-base leading-relaxed">Procedimento planejado com anestesia moderna para total previsibilidade e conforto.</p>
          </div>
        </div>
        <div class="relative group pl-16 jornada-step" data-reveal data-reveal-delay="225">
          <div class="absolute left-[19px] top-1.5 w-3.5 h-3.5 rounded-full bg-amber-400 border-2 border-amber-200 shadow-[0_0_12px_#fbbf24] z-20 step-dot"></div>
          <div>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-white mb-2">Passo 03: Instalação dos Dentes Fixos</h3>
            <p class="text-slate-400 text-base leading-relaxed">Prótese definitiva posicionada para devolver a mastigação e a liberdade de sorrir.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. AUTORIDADE -->
  <section id="autoridade" class="relative bg-white py-16 sm:py-24 border-b border-slate-200 text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="block lg:hidden text-center mb-8" data-reveal>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold-400/15 text-gold-700 text-xs font-bold uppercase tracking-wider border border-gold-400/30 mb-2">Trajetória e Compromisso</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight mt-2 mb-4">Atendimento Pessoal do Início ao Fim</h2>
        <p class="text-slate-600 text-base leading-relaxed px-4">Com mais de 20 anos de atuação clínica no Centro de Passos, o Dr. Luciano Alves Freire (CRO-MG 25170) conduz pessoalmente cada etapa do seu tratamento, do diagnóstico inicial à reabilitação final.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
        <div class="lg:col-span-5 flex justify-center" data-reveal data-reveal-delay="100">
          <div class="relative w-full max-w-[270px] sm:max-w-xs lg:max-w-md">
            <div class="relative rounded-2xl overflow-hidden bg-slate-50 border border-slate-200 shadow-xl card-tactile">
