---
const whatsappBaseUrl = "https://wa.me/5535988215162";
const heroWhatsappUrl = `${whatsappBaseUrl}?text=Ol%C3%A1%2C%20Dr.%20Luciano.%20Gostaria%20de%20agendar%20uma%20avalia%C3%A7%C3%A3o`;
const googleMapsAddressUrl = "https://www.google.com/maps/search/?api=1&query=Rua+dos+Brand%C3%B5es%2C+231+-+Sala+24+-+Centro%2C+Passos+-+MG%2C+37900-104";
---

<!-- HEADER INSTITUCIONAL -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-surface-soft transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 sm:h-24">
      
      <!-- Logo Oficial Simplificada (Símbolo + Nome) -->
      <a
        href="/"
        class="group flex items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue rounded-lg btn-tactile py-1"
        aria-label="Luciano Alves Freire, Consultório Odontológico, Implantodontia e Ortodontia - Início"
      >
        <img
          id="header-logo-img"
          src="/images/logo-simplificada.svg"
          alt="Luciano Alves Freire, Consultório Odontológico, Implantodontia e Ortodontia"
          class="h-11 sm:h-14 w-auto object-contain group-hover:opacity-95 transition-all duration-150 shrink-0"
          width="144"
          height="56"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation (Fontes >= 16px, Contraste AA) -->
      <nav class="hidden lg:flex items-center gap-5 xl:gap-7 text-[1.0625rem] font-semibold text-brand-dark">
        <a href="/#triagem" class="hover:text-brand-blue transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue rounded px-1">Tratamentos</a>
        <a href="/#comparador" class="hover:text-brand-blue transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue rounded px-1">Comparador</a>
        <a href="/#autoridade" class="hover:text-brand-blue transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue rounded px-1">Dr. Luciano</a>
        <a href="/#avaliacoes" class="hover:text-brand-blue transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue rounded px-1">Avaliações</a>
        <a href="/#ambientes" class="hover:text-brand-blue transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue rounded px-1">Ambientes</a>
        <a href="/#faq" class="hover:text-brand-blue transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue rounded px-1">Dúvidas</a>
        <a href="/#localizacao" class="hover:text-brand-blue transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue rounded px-1">Localização</a>
      </nav>

      <!-- CTA Header (Touch target >= 48px, texto >= 18px) -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <a
          href={heroWhatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-tactile inline-flex items-center justify-center gap-2 sm:gap-2.5 px-4 sm:px-5 py-2.5 sm:py-3 min-h-[48px] rounded-xl bg-whatsapp text-slate-950 font-bold text-base sm:text-[1.125rem] shadow-sm hover:bg-whatsapp-hover transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
          aria-label="Agendar Avaliação no Consultório via WhatsApp"
        >
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
          <span class="hidden sm:inline">Agendar Avaliação</span>
          <span class="sm:hidden">Agendar</span>
        </a>

        <!-- Botão Menu Mobile (Apenas < lg) -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="lg:hidden p-2.5 rounded-xl border border-brand-pale/90 text-brand-dark bg-white hover:text-brand-blue hover:border-brand-blue/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue min-w-[48px] min-h-[48px] flex items-center justify-center transition-colors shadow-2xs"
          aria-label="Abrir menu de navegação"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
        >
          <svg id="hamburger-icon" class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- DRAWER DE NAVEGAÇÃO MOBILE (FORA DO HEADER PARA NÃO SER PRESO POR BACKDROP-FILTER) -->
<div
  id="mobile-menu-drawer"
  class="fixed inset-0 z-[999] lg:hidden pointer-events-none opacity-0 invisible transition-all duration-300"
  aria-hidden="true"
>
  <!-- Backdrop com desfoque de tela cheia -->
  <div id="mobile-menu-backdrop" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm transition-opacity"></div>

  <!-- Painel Lateral Deslizante -->
  <div
    id="mobile-menu-panel"
    class="fixed top-0 right-0 w-full max-w-sm h-full max-h-screen bg-white shadow-2xl flex flex-col justify-between p-6 transform translate-x-full transition-transform duration-300 ease-out overflow-y-auto z-10"
  >
    <div>
      <!-- Topo do Painel: Logo e Fechar -->
      <div class="flex items-center justify-between pb-4 border-b border-brand-pale">
        <a href="/" class="flex items-center gap-2">
          <img src="/images/logo-simplificada.svg" alt="Dr. Luciano Freire" class="h-10 w-auto" width="102" height="40" loading="lazy" />
        </a>
        <button
          id="mobile-menu-close"
          class="p-2 rounded-xl text-slate-500 hover:text-brand-dark hover:bg-slate-100 min-w-[44px] min-h-[44px] flex items-center justify-center transition-colors"
          aria-label="Fechar menu"
        >
          <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Tópicos de Navegação Rápida da Página -->
      <div class="py-4 border-b border-brand-pale">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">Navegação Rápida</p>
        <nav class="space-y-1">
          <a href="/#triagem" class="flex items-center gap-2.5 py-2.5 px-3 rounded-xl text-base font-semibold text-brand-dark hover:bg-surface-soft hover:text-brand-blue transition-colors">
            <span class="w-2 h-2 rounded-full bg-brand-blue shrink-0"></span>
            <span>Tratamentos Especializados</span>
          </a>
          <a href="/#comparador" class="flex items-center gap-2.5 py-2.5 px-3 rounded-xl text-base font-semibold text-brand-dark hover:bg-surface-soft hover:text-brand-blue transition-colors">
            <span class="w-2 h-2 rounded-full bg-brand-blue shrink-0"></span>
            <span>Comparador Anatômico</span>
          </a>
          <a href="/#autoridade" class="flex items-center gap-2.5 py-2.5 px-3 rounded-xl text-base font-semibold text-brand-dark hover:bg-surface-soft hover:text-brand-blue transition-colors min-h-[44px]">
            <span class="w-2 h-2 rounded-full bg-brand-blue shrink-0"></span>
            <span>Dr. Luciano Alves Freire</span>
          </a>
          <a href="/#avaliacoes" class="flex items-center gap-2.5 py-2.5 px-3 rounded-xl text-base font-semibold text-brand-dark hover:bg-surface-soft hover:text-brand-blue transition-colors">
            <span class="w-2 h-2 rounded-full bg-brand-blue shrink-0"></span>
            <span>Avaliações dos Pacientes (5.0)</span>
          </a>
          <a href="/#ambientes" class="flex items-center gap-2.5 py-2.5 px-3 rounded-xl text-base font-semibold text-brand-dark hover:bg-surface-soft hover:text-brand-blue transition-colors">
            <span class="w-2 h-2 rounded-full bg-brand-blue shrink-0"></span>
            <span>Ambientes do Consultório</span>
          </a>
          <a href="/#faq" class="flex items-center gap-2.5 py-2.5 px-3 rounded-xl text-base font-semibold text-brand-dark hover:bg-surface-soft hover:text-brand-blue transition-colors min-h-[44px]">
            <span class="w-2 h-2 rounded-full bg-brand-blue shrink-0"></span>
            <span>Dúvidas Frequentes</span>
          </a>
          <a href="/#localizacao" class="flex items-center gap-2.5 py-2.5 px-3 rounded-xl text-base font-semibold text-brand-dark hover:bg-surface-soft hover:text-brand-blue transition-colors min-h-[44px]">
            <span class="w-2 h-2 rounded-full bg-brand-blue shrink-0"></span>
            <span>Localização no Centro de Passos</span>
          </a>
        </nav>
      </div>

      <!-- Páginas de Tratamentos Específicos -->
      <div class="py-4 border-b border-brand-pale">
        <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">Páginas de Tratamentos</p>
        <div class="grid grid-cols-2 gap-2">
          <a href="/servicos/implantes" class="p-3 rounded-xl bg-surface-subtle border border-brand-pale/70 font-bold text-sm text-brand-dark hover:bg-brand-blue hover:text-white transition-colors flex items-center justify-between">
            <span>Implantes</span>
            <span class="text-xs opacity-60">→</span>
          </a>
          <a href="/servicos/protocolo" class="p-3 rounded-xl bg-surface-subtle border border-brand-pale/70 font-bold text-sm text-brand-dark hover:bg-brand-blue hover:text-white transition-colors flex items-center justify-between">
            <span>Protocolo</span>
            <span class="text-xs opacity-60">→</span>
          </a>
          <a href="/servicos/ortodontia" class="p-3 rounded-xl bg-surface-subtle border border-brand-pale/70 font-bold text-sm text-brand-dark hover:bg-brand-blue hover:text-white transition-colors flex items-center justify-between">
            <span>Ortodontia</span>
            <span class="text-xs opacity-60">→</span>
          </a>
          <a href="/servicos/estetica" class="p-3 rounded-xl bg-surface-subtle border border-brand-pale/70 font-bold text-sm text-brand-dark hover:bg-brand-blue hover:text-white transition-colors flex items-center justify-between">
            <span>Estética</span>
            <span class="text-xs opacity-60">→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Rodapé do menu com contato direto e endereço com link do Maps -->
    <div class="pt-5 border-t border-brand-pale space-y-3">
      <a
        href={heroWhatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2.5 bg-whatsapp hover:bg-whatsapp-hover text-slate-950 font-bold py-3.5 px-4 rounded-xl shadow-sm text-base min-h-[48px]"
      >
        <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.297.144.35.491 1.199.534 1.286.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.353.101.173.45 0.742.965 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.043.101-.116.433-.506.549-.679.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/></svg>
        <span>Falar no WhatsApp</span>
      </a>

      <!-- Link Direto para o Google Maps no endereço exato -->
      <a
        href={googleMapsAddressUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="block text-center text-xs text-slate-500 hover:text-brand-blue transition-colors py-1 underline-offset-2 hover:underline"
        title="Abrir endereço no Google Maps"
      >
        Passos/MG • Rua dos Brandões, 231, Sala 24 – Centro
      </a>
    </div>
  </div>
</div>

<script is:inline>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-menu-drawer');
    const panel = document.getElementById('mobile-menu-panel');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const closeBtn = document.getElementById('mobile-menu-close');
    if (!btn || !drawer || !panel) return;

    // Garante que o drawer seja filho direto de body para não ser restringido por stacking contexts
    if (drawer.parentElement && drawer.parentElement !== document.body) {
      document.body.appendChild(drawer);
    }

    const links = drawer.querySelectorAll('a');

    function openMenu() {
      drawer.classList.remove('pointer-events-none', 'opacity-0', 'invisible');
      drawer.classList.add('pointer-events-auto', 'opacity-100', 'visible');
      panel.classList.remove('translate-x-full');
      btn.setAttribute('aria-expanded', 'true');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      drawer.classList.add('pointer-events-none', 'opacity-0');
      panel.classList.add('translate-x-full');
      btn.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (drawer.getAttribute('aria-hidden') === 'true') {
          drawer.classList.add('invisible');
          drawer.classList.remove('visible');
        }
      }, 300);
    }

    btn.onclick = (e) => {
      e.stopPropagation();
      openMenu();
    };

    if (closeBtn) closeBtn.onclick = closeMenu;
    if (backdrop) backdrop.onclick = closeMenu;

    links.forEach((l) => {
      l.addEventListener('click', () => {
        closeMenu();
      });
    });

    window.onkeydown = (e) => {
      if (e.key === 'Escape') closeMenu();
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
