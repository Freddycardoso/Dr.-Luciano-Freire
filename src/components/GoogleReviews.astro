          <!-- Rodapé do Card: Autenticação e Link Oficial Google Maps -->
          <div class="mt-6 pt-4 border-t border-brand-pale/60 flex items-center justify-between text-sm">
            <a
              href={googleReviewsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-blue hover:text-brand-deep font-semibold inline-flex items-center gap-1 min-h-[44px] transition-colors group/link focus-visible:outline-none focus-visible:underline"
              aria-label={`Ver avaliação de ${rev.author} no Google`}
            >
              <span>Avaliação no Google</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
