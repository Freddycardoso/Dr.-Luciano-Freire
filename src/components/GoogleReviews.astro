        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          
          <!-- Lado Esquerdo: O Grande Número 5.0 e Estrelas Douradas -->
          <div class="md:col-span-5 flex flex-col sm:flex-row md:flex-col lg:flex-row items-center gap-5 sm:gap-6 text-center sm:text-left md:text-center lg:text-left border-b md:border-b-0 md:border-r border-brand-pale/70 pb-6 md:pb-0 md:pr-6">
            <!-- Box do Logo Google -->
