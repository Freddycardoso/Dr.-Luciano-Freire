---
// src/components/GoogleReviews.astro
// Componente Oficial de Avaliações do Google - 100% Nativo, Dark Luxury & Zero Scripts Externos

interface Review {
  id: string;
  author: string;
  initial: string;
  avatarBg: string;
  rating: number;
  time: string;
  text: string;
  verified: boolean;
  highlight?: boolean;
}

const reviews: Review[] = [
  {
    id: "rev-1",
    author: "Fabiane Oliveira",
    initial: "F",
    avatarBg: "from-amber-600 to-amber-700",
    rating: 5,
    time: "4 anos atrás",
    text: "Se tivessem mais estrelas daria, excelente profissional, pontual, mto humano, trabalha mto bem, super recomendo.",
    verified: true,
    highlight: true,
  },
  {
    id: "rev-2",
    author: "Gerson Eduardo Rosa",
    initial: "G",
    avatarBg: "from-emerald-600 to-teal-700",
    rating: 5,
    time: "4 anos atrás",
    text: "Excelente atendimento. Pontualidade e cordialidade com os clientes.",
    verified: true,
  },
  {
    id: "rev-3",
    author: "Inovatório Marketing e Design",
    initial: "I",
    avatarBg: "from-red-500 to-rose-600",
    rating: 5,
    time: "14 dias atrás",
    text: "Excelente Atendimento e Cuidado!",
    verified: true,
  },
  {
    id: "rev-4",
    author: "Ana Teresa Roberto Braz Rosa",
    initial: "A",
    avatarBg: "from-purple-600 to-indigo-700",
    rating: 5,
    time: "4 anos atrás",
    text: "Espetacular! Profissionalismo impecável e atenção dedicada em cada etapa do atendimento odontológico.",
    verified: true,
  },
  {
    id: "rev-5",
    author: "Marco Arantes",
    initial: "M",
    avatarBg: "from-blue-600 to-cyan-700",
    rating: 5,
    time: "4 anos atrás",
    text: "Pontualidade, higiene, profissionalismo e excelente atendimento destacam o Dr. Luciano Alves Freire como um dos dentistas mais preparados que conheci.",
    verified: true,
    highlight: true,
  },
  {
    id: "rev-6",
    author: "Maria Helena Silveira",
    initial: "M",
    avatarBg: "from-amber-700 to-yellow-800",
    rating: 5,
    time: "Paciente Verificada",
    text: "Doutor Luciano me devolveu a segurança de sorrir e mastigar. Procedimento de implante muito tranquilo, sem dor e com acompanhamento impecável.",
    verified: true,
  },
];

const googleMapsUrl = "https://maps.google.com/?cid=7746098254252380456";
---

<div class="w-full relative" id="google-reviews-native">
  <!-- Cartão Superior Oficial do Google (Summary Card) -->
  <div class="mb-8 p-6 sm:p-7 rounded-2xl bg-gradient-to-r from-slate-900/90 via-slate-900/95 to-slate-900/90 border border-slate-800 shadow-2xl backdrop-blur-sm flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
      <!-- Ícone Oficial Google -->
      <div class="w-14 h-14 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-center shadow-inner shrink-0">
        <svg class="w-8 h-8" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.65v3.03h3.88c2.27-2.09 3.665-5.17 3.665-9.12z"/>
          <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.03c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.13C3.28 21.44 7.33 24 12 24z"/>
          <path fill="#FBBC05" d="M5.28 14.29c-.25-.72-.38-1.49-.38-2.29s.13-1.57.38-2.29V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.13z"/>
          <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.28 2.56 1.25 6.58l4.03 3.13c.95-2.83 3.6-4.96 6.72-4.96z"/>
        </svg>
      </div>

      <div>
        <div class="flex items-center justify-center sm:justify-start gap-2">
          <span class="text-xl sm:text-2xl font-bold text-white tracking-tight">Google</span>
          <span class="text-xl sm:text-2xl font-light text-slate-300">Avaliações</span>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            Verificado
          </span>
        </div>
        <div class="flex items-center justify-center sm:justify-start gap-2.5 mt-1.5">
          <span class="text-2xl font-extrabold text-white">5.0</span>
          <div class="flex items-center text-amber-400 gap-0.5">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-4 h-4 fill-current drop-shadow-[0_0_8px_rgba(212,175,55,0.4)]" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <span class="text-xs text-slate-400">13+ avaliações reais</span>
        </div>
      </div>
    </div>

    <!-- Botões de Ação do Header -->
    <div class="flex items-center gap-3 w-full sm:w-auto justify-center">
      <a
        href={googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-gold-400 to-gold-500 hover:from-gold-300 hover:to-gold-400 text-slate-950 font-bold text-xs shadow-lg shadow-gold-500/10 hover:shadow-gold-500/25 transition-all transform hover:-translate-y-0.5 active:translate-y-0"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span>Avaliar no Google</span>
      </a>

      <!-- Controles do Carrossel (Setas) -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          id="reviews-prev-btn"
          aria-label="Avaliação anterior"
          class="w-10 h-10 rounded-xl bg-slate-950/80 hover:bg-slate-800 text-slate-300 hover:text-gold-300 border border-slate-800 hover:border-gold-400/40 flex items-center justify-center transition-all disabled:opacity-30 disabled:pointer-events-none"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button
          type="button"
          id="reviews-next-btn"
          aria-label="Próxima avaliação"
          class="w-10 h-10 rounded-xl bg-slate-950/80 hover:bg-slate-800 text-slate-300 hover:text-gold-300 border border-slate-800 hover:border-gold-400/40 flex items-center justify-center transition-all disabled:opacity-30 disabled:pointer-events-none"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Carrossel de Cards -->
  <div
    id="reviews-track"
    class="flex gap-5 overflow-x-auto scrollbar-none snap-x snap-mandatory py-2 scroll-smooth -mx-4 px-4 sm:mx-0 sm:px-0"
    style="scrollbar-width: none; -ms-overflow-style: none;"
  >
    {reviews.map((rev) => (
      <div
        class="w-[85vw] sm:w-[360px] md:w-[380px] shrink-0 snap-start flex flex-col justify-between p-6 sm:p-7 rounded-2xl bg-gradient-to-b from-slate-900/90 to-slate-950/90 border border-slate-800/80 hover:border-gold-400/40 transition-all duration-300 shadow-xl hover:shadow-gold-500/5 group relative"
      >
        <!-- Aspas decorativas sutis de fundo -->
        <div class="absolute top-5 right-6 text-slate-800/40 group-hover:text-gold-400/10 transition-colors pointer-events-none">
          <svg class="w-12 h-12 fill-current" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
        </div>

        <div>
          <!-- Perfil do Autor -->
          <div class="flex items-center gap-3.5 mb-4">
            <div class="relative">
              <div class={`w-11 h-11 rounded-full bg-gradient-to-br ${rev.avatarBg} text-white font-bold flex items-center justify-center text-sm shadow-md`}>
                {rev.initial}
              </div>
              <!-- Badge Google no avatar -->
              <div class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-slate-950 border border-slate-800 flex items-center justify-center shadow">
                <svg class="w-3 h-3" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.65v3.03h3.88c2.27-2.09 3.665-5.17 3.665-9.12z"/>
                  <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.03c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.13C3.28 21.44 7.33 24 12 24z"/>
                  <path fill="#FBBC05" d="M5.28 14.29c-.25-.72-.38-1.49-.38-2.29s.13-1.57.38-2.29V6.58H1.25C.45 8.18 0 9.99 0 12s.45 3.82 1.25 5.42l4.03-3.13z"/>
                  <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.33 0 3.28 2.56 1.25 6.58l4.03 3.13c.95-2.83 3.6-4.96 6.72-4.96z"/>
                </svg>
              </div>
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5">
                <h4 class="text-sm font-semibold text-white truncate group-hover:text-gold-200 transition-colors">
                  {rev.author}
                </h4>
                {rev.verified && (
                  <svg class="w-3.5 h-3.5 text-blue-400 shrink-0" viewBox="0 0 20 20" fill="currentColor" title="Perfil verificado">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                )}
              </div>
              <span class="text-xs text-slate-400 block mt-0.5">{rev.time}</span>
            </div>
          </div>

          <!-- Estrelas Douradas -->
          <div class="flex items-center text-amber-400 gap-0.5 mb-3.5">
            {Array.from({ length: rev.rating }).map(() => (
              <svg class="w-4 h-4 fill-current drop-shadow-[0_0_6px_rgba(212,175,55,0.3)]" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Texto do Depoimento -->
          <p class="text-slate-300 text-[13px] sm:text-sm leading-relaxed line-clamp-4 group-hover:text-slate-200 transition-colors">
            "{rev.text}"
          </p>
        </div>

        <!-- Rodapé do Card com link direto -->
        <div class="mt-5 pt-3.5 border-t border-slate-800/60 flex items-center justify-between text-xs text-slate-400">
          <span class="inline-flex items-center gap-1.5 text-gold-400/90 font-medium">
            <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
            Avaliação autêntica
          </span>
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-white transition-colors flex items-center gap-1"
          >
            Google Maps
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    ))}
  </div>

  <!-- Indicador de arraste no mobile -->
  <div class="mt-4 flex sm:hidden items-center justify-center gap-1 text-[11px] text-slate-400">
    <svg class="w-4 h-4 animate-pulse text-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
    </svg>
    <span>Deslize para ver mais avaliações</span>
  </div>
</div>

<script is:inline>
  (function initReviewsCarousel() {
    const track = document.getElementById('reviews-track');
    const prevBtn = document.getElementById('reviews-prev-btn');
    const nextBtn = document.getElementById('reviews-next-btn');

    if (!track || !prevBtn || !nextBtn) return;

    function getScrollStep() {
      const card = track.querySelector('div');
      return card ? card.offsetWidth + 20 : 380;
    }

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
    });

    function updateArrows() {
      const atStart = track.scrollLeft <= 5;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 5;
      prevBtn.disabled = atStart;
      nextBtn.disabled = atEnd;
    }

    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows, { passive: true });
    updateArrows();
  })();
</script>

<style>
  /* Esconder barra de rolagem em todos os navegadores */
  #reviews-track {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  #reviews-track::-webkit-scrollbar {
    display: none;
  }
</style>
