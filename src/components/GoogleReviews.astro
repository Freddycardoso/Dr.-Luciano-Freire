      <div class="relative overflow-hidden rounded-3xl bg-white border border-brand-pale shadow-[0_16px_40px_-12px_rgba(66,107,178,0.12)] p-6 sm:p-8 lg:p-10 transition-all duration-300">
        <!-- Barra de realce superior com o degradê azul da clínica -->
