];

// Endereço exato do Consultório no Google Maps (Rua dos Brandões, 231, Sala 24 – Centro, Passos - MG)
const googleMapsAddressUrl = "https://www.google.com/maps/search/?api=1&query=Rua+dos+Brand%C3%B5es%2C+231+-+Sala+24+-+Centro%2C+Passos+-+MG%2C+37900-104";

// Perfil Oficial Google Meu Negócio / Avaliações do Dr. Luciano Alves Freire
const googleReviewsUrl = "https://www.google.com/maps/search/?api=1&query=Consult%C3%B3rio+Odontol%C3%B3gico+Dr.+Luciano+Alves+Freire+Rua+dos+Brand%C3%B5es+231+Passos+MG";
---

<section
  id="avaliacoes"
  class="relative bg-surface-subtle py-20 lg:py-28 border-b border-brand-pale overflow-hidden text-brand-dark"
  aria-labelledby="reviews-heading"
>
  <!-- Ambient background lighting com as cores da clínica -->
  <div class="absolute top-1/4 -right-40 w-96 h-96 rounded-full bg-brand-light/20 blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 -left-40 w-96 h-96 rounded-full bg-brand-pale/30 blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Cabeçalho da Seção -->
    <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16" data-reveal>
      
