    </div>

    <!-- Barra de Confiabilidade Inferior: Compromisso Ético e Atendimento -->
    <div class="mt-12 pt-8 border-t border-brand-pale text-center" data-reveal>
      <div class="inline-flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-base text-slate-600">
        <span class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-accent-green"></span>
          <strong>Dr. Luciano Alves Freire</strong> • Cirurgião-Dentista • CRO MG 25.170
        </span>
        <span class="hidden sm:inline text-brand-pale">•</span>
        <span>Atendimento exclusivo e individualizado no Centro de Passos/MG</span>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  (function initGoogleReviews() {
    const track = document.getElementById('reviews-track');
    const prevBtn = document.getElementById('reviews-prev');
    const nextBtn = document.getElementById('reviews-next');
    const filterBtns = document.querySelectorAll('.review-filter-btn');
    const cards = document.querySelectorAll('.review-card');

    if (!track || !prevBtn || !nextBtn) return;

    // Cálculo fluido de passo de rolagem
    function getScrollStep() {
      const firstCard = track.querySelector('.review-card:not(.hidden)');
      if (!firstCard) return 380;
      return firstCard.offsetWidth + 24; // largura + gap
    }

    // Navegação anterior / próxima
    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
    });

    // Atualização de estado ativo das setas
    function updateArrows() {
      const atStart = track.scrollLeft <= 10;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 10;
      prevBtn.disabled = atStart;
      nextBtn.disabled = atEnd;
    }

    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows, { passive: true });
    setTimeout(updateArrows, 100);

    // Sistema de Filtros por Pilares Clínicos (Emil Kowalski micro-motion)
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        // Atualizar estado visual dos botões de filtro
        filterBtns.forEach(b => {
          b.classList.remove('bg-brand-blue', 'text-white', 'border-brand-blue', 'shadow-sm');
          b.classList.add('bg-white', 'text-brand-dark', 'border-brand-pale');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.add('bg-brand-blue', 'text-white', 'border-brand-blue', 'shadow-sm');
        btn.classList.remove('bg-white', 'text-brand-dark', 'border-brand-pale');
        btn.setAttribute('aria-selected', 'true');

        // Filtrar cards com transição suave
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (category === 'all' || cardCat === category) {
            card.classList.remove('hidden');
            card.style.opacity = '0';
            card.style.transform = 'scale(0.97)';
            setTimeout(() => {
              card.style.transition = 'opacity 220ms cubic-bezier(0.16, 1, 0.3, 1), transform 220ms cubic-bezier(0.16, 1, 0.3, 1)';
              card.style.opacity = '1';
              card.style.transform = 'scale(1)';
            }, 30);
          } else {
            card.classList.add('hidden');
          }
        });

        // Reset scroll position suave
        track.scrollTo({ left: 0, behavior: 'smooth' });
        setTimeout(updateArrows, 150);
      });
    });
  })();
</script>

<style>
  /* Esconder barra de rolagem em todos os navegadores para aspecto refinado */
  #reviews-track {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  #reviews-track::-webkit-scrollbar {
    display: none;
  }
</style>
