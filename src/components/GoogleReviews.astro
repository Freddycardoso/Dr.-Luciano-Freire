    }
  },
  {
    id: "rev-fabiane-oliveira",
    author: "Fabiane Oliveira",
    stats: "2 avaliações no Google",
    rating: 5,
    time: "4 anos atrás",
    tag: "Atendimento Humano",
    category: "humano",
    text: "Se tivessem mais estrelas daria, excelente profissional, pontual, muito humano, trabalha muito bem, super recomendo.",
    highlight: true,
  },
  {
    id: "rev-gerson-rosa",
    author: "Gerson Eduardo Rosa",
    stats: "3 avaliações no Google",
    rating: 5,
    time: "4 anos atrás",
    tag: "Pontualidade & Cordialidade",
    category: "pontualidade",
    text: "Excelente atendimento. Pontualidade e cordialidade com os clientes.",
  },
  {
    id: "rev-marcobrandao-queiros",
    author: "Marco Brandão Queirós",
