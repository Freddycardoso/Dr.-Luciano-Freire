  <!-- =========================================================================
       DOBRA 2: SE├ç├âO COMPARATIVA INTERATIVA ÔÇö ANATOMIA & IMPLANTE DENTAL
       - Fim dos cart├Áes dentro de cart├Áes (Zero SaaS)
       - Slider de revela├º├úo interativo com hardware acceleration
       - Dossi├¬ editorial com linhas finas e tipografia m├®dica de luxo
       ========================================================================= -->
  <section id="anatomia" class="relative bg-slate-50 py-20 lg:py-28 border-t border-b border-slate-200 text-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Cabe├ºalho Editorial -->
