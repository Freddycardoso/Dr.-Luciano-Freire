      </div>

      <!-- Layout Editorial em 2 Colunas: Slider Interativo + Dossi├¬ Cl├¡nico -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center mb-16">
        
        <!-- Coluna da Esquerda: Slider Interativo -->
        <div class="lg:col-span-6 flex flex-col items-center justify-center" data-reveal data-reveal-delay="100">
          <div class="p-2 sm:p-3 rounded-3xl bg-white border border-slate-200/90 shadow-xl w-full max-w-[440px]">
            <AnatomyComparisonSlider
              client:visible
              naturalSrc={denteNaturalImg.src}
              implantSrc={implanteTitanioImg.src}
